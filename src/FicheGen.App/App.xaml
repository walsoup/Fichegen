<Application
    x:Class="FicheGen.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FicheGen.App"
    xmlns:converters="using:FicheGen.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ========================================================================= -->
            <!-- THEME DICTIONARIES (Light, Dark, HighContrast)                            -->
            <!-- ========================================================================= -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="PROFstudioLogoBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0078D4" Offset="0.0" />
                        <GradientStop Color="#002050" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="AiChipBackgroundBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="AiChipBorderBrush" Color="#30FFFFFF" />
                    <SolidColorBrush x:Key="AiStatusOnlineBrush" Color="#107C41" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#15FFFFFF"/>
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#15FFFFFF"/>
                    <SolidColorBrush x:Key="StatusPositiveFgBrush" Color="#6CCB5F"/>
                    <SolidColorBrush x:Key="StatusPositiveBgBrush" Color="#1F6CCB5F"/>
                    <SolidColorBrush x:Key="StatusCautionFgBrush" Color="#FCE100"/>
                    <SolidColorBrush x:Key="StatusCautionBgBrush" Color="#1FFCE100"/>
                    <SolidColorBrush x:Key="StatusCriticalFgBrush" Color="#FF99A4"/>
                    <SolidColorBrush x:Key="StatusCriticalBgBrush" Color="#1FFF99A4"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="PROFstudioLogoBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0078D4" Offset="0.0" />
                        <GradientStop Color="#005A9E" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="AiChipBackgroundBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="AiChipBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="AiStatusOnlineBrush" Color="#107C41" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FBFBFB"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#F0F0F0"/>
                    <SolidColorBrush x:Key="StatusPositiveFgBrush" Color="#0F7B0F"/>
                    <SolidColorBrush x:Key="StatusPositiveBgBrush" Color="#1F0F7B0F"/>
                    <SolidColorBrush x:Key="StatusCautionFgBrush" Color="#9D5D00"/>
                    <SolidColorBrush x:Key="StatusCautionBgBrush" Color="#1F9D5D00"/>
                    <SolidColorBrush x:Key="StatusCriticalFgBrush" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="StatusCriticalBgBrush" Color="#1FC42B1C"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PROFstudioLogoBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AiChipBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AiChipBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AiStatusOnlineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="StatusPositiveFgBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="StatusPositiveBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="StatusCautionFgBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="StatusCautionBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="StatusCriticalFgBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="StatusCriticalBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Application-wide Fallback Resources -->
            <LinearGradientBrush x:Key="PROFstudioLogoBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0078D4" Offset="0.0" />
                <GradientStop Color="#005A9E" Offset="1.0" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AiChipBackgroundBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="AiChipBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="AiStatusOnlineBrush" Color="#107C41" />

            <!-- ========================================================================= -->
            <!-- PROFstudio DESIGN SYSTEM · COMPONENT STYLES & TOKENS                      -->
            <!-- ========================================================================= -->

            <!-- Boutons subtils -->
            <Style x:Key="SubtleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="Transparent" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SubtleTransparentButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}" />

            <!-- Conteneur de carte de formulaire (Étape 1, 2, 3) -->
            <Style x:Key="FormCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource FormCardStyle}"/>

            <!-- Puce de sélection rapide (ChoiceChip) -->
            <Style x:Key="ChoiceChipStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Pilule de métadonnées (Historique) -->
            <Style x:Key="MetaPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Style d'élément conteneur d'historique -->
            <Style x:Key="HistoryItemContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,10"/>
            </Style>

            <!-- Typographie -->
            <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Style>

            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Spacing & Padding Tokens -->
            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="CardMargin">0,0,0,12</Thickness>
            <Thickness x:Key="FieldMargin">0,0,0,12</Thickness>
            <Thickness x:Key="ChipPadding">12,6</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>

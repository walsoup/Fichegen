<Window
    x:Class="FicheGen.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PROFstudio">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- ===== Raccourcis clavier (voir aussi Ctrl+, ajouté dans le code) ===== -->
        <Grid.KeyboardAccelerators>
            <!-- Génération & annulation -->
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnCtrlGInvoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscInvoked"/>
            <!-- Volets & actions rapides -->
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnCtrlBInvoked"/>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCtrlNInvoked"/>
            <KeyboardAccelerator Key="E" Modifiers="Control, Shift" Invoked="OnCtrlShiftEInvoked"/>
            <KeyboardAccelerator Key="W" Modifiers="Control, Shift" Invoked="OnCtrlShiftWInvoked"/>
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnCtrlPInvoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnCtrlFInvoked"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnCtrlZInvoked"/>
            <!-- Navigation entre sections -->
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnCtrlTabInvoked"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control, Shift" Invoked="OnCtrlShiftTabInvoked"/>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <!-- Aide -->
            <KeyboardAccelerator Key="F1" Invoked="OnF1Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Barre de titre personnalisée (Fluent 2) ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent"
              AutomationProperties.Name="Barre de titre PROFstudio">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo + identité -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="16,0,0,0" Spacing="10">
                <Border Width="30" Height="30" CornerRadius="8"
                        Background="{ThemeResource PROFstudioLogoBrush}">
                    <TextBlock Text="📘" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PROFstudio" FontWeight="SemiBold" FontSize="15" LineHeight="18"
                               AutomationProperties.HeadingLevel="Level1"/>
                </StackPanel>
            </StackPanel>

            <!-- Titre central / état -->
            <Button x:Name="AiProviderChip" Grid.Column="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="14,4" CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Click="OnAiChipClicked"
                    AutomationProperties.Name="Assistant IA"
                    ToolTipService.ToolTip="Statut de l'assistant IA">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="AiStatusGlyph" Text="○" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="AiProviderChipText" Text="Assistant IA — vérification…" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Actions rapides + profil -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="0,0,12,0">

                <ToggleButton x:Name="AssistantToggleButton" CornerRadius="8" Padding="12,5"
                              Click="OnAssistantToggleClicked"
                              ToolTipService.ToolTip="Afficher ou masquer l'Assistant IA (Ctrl+B)"
                              AutomationProperties.Name="Assistant IA">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="💬" FontSize="13"/>
                        <TextBlock Text="Assistant" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Button x:Name="ThemeButton" Padding="8,5" CornerRadius="8"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="Thème d'affichage : Clair, Sombre ou Système"
                        AutomationProperties.Name="Changer de thème">
                    <FontIcon Glyph="&#xE793;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="🖥️  Système (par défaut)"
                                                 Tag="System" IsChecked="True" Click="OnThemeItemClick"/>
                            <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="☀️  Clair"
                                                 Tag="Light" Click="OnThemeItemClick"/>
                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="🌙  Sombre"
                                                 Tag="Dark" Click="OnThemeItemClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="SettingsButton" Padding="8,5" CornerRadius="8"
                        Background="Transparent" BorderBrush="Transparent"
                        Click="OnSettingsClicked"
                        ToolTipService.ToolTip="Paramètres (Ctrl+,)"
                        AutomationProperties.Name="Paramètres">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                </Button>

                <Border Width="1" Height="18" Margin="2,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Profil enseignant -->
                <Button x:Name="ProfileButton" Padding="2" CornerRadius="16"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="Profil enseignant"
                        AutomationProperties.Name="Profil enseignant">
                    <PersonPicture x:Name="TeacherPersonPicture" Width="28" Height="28"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="280" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,6,6,10">
                                    <PersonPicture x:Name="TeacherPersonPictureLarge" Width="44" Height="44"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="ProfileNameText" Text="Enseignant·e"
                                                   FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="ProfileSubtext" Text="Vos documents sont enregistrés sur cet ordinateur"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnProfileSettingsClicked"
                                        AutomationProperties.Name="Paramètres">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="⚙️" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Paramètres de l'application" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnProfileShortcutsClicked"
                                        AutomationProperties.Name="Raccourcis clavier">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="⌨️" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Raccourcis clavier (F1)" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnAboutClicked"
                                        AutomationProperties.Name="À propos">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="ℹ️" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="À propos de PROFstudio" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Navigation principale ================= -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="900"
                        ExpandedModeThresholdWidth="1200"
                        OpenPaneLength="260"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="OnNavSelectionChanged"
                        ItemInvoked="OnNavItemInvoked"
                        AutomationProperties.Name="Navigation principale">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="GlobalSearchBox"
                                PlaceholderText="Rechercher un document…"
                                QueryIcon="Find"
                                QuerySubmitted="OnGlobalSearchSubmitted"
                                ToolTipService.ToolTip="Rechercher dans mes documents (Ctrl+F)"
                                AutomationProperties.Name="Recherche globale"/>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Fiche pédagogique" Tag="FichePage"
                                    ToolTipService.ToolTip="Créer une fiche de séance (Ctrl+1)"
                                    AutomationProperties.Name="Fiche pédagogique">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Évaluations &amp; Contrôles" Tag="EvaluationPage"
                                    ToolTipService.ToolTip="Créer une évaluation avec barème (Ctrl+2)"
                                    AutomationProperties.Name="Évaluations et Contrôles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Quiz rapides" Tag="QuizPage"
                                    ToolTipService.ToolTip="Créer un quiz ou QCM (Ctrl+3)"
                                    AutomationProperties.Name="Quiz rapides">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mes documents" Tag="HistoryPage"
                                    ToolTipService.ToolTip="Retrouver tous mes documents créés (Ctrl+4)"
                                    AutomationProperties.Name="Mes documents">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Aide &amp; Raccourcis" Tag="Help" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Aide et raccourcis clavier (F1)"
                                    AutomationProperties.Name="Aide et raccourcis clavier">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- ================= Barre de notification & d'état active (§5.3) ================= -->
        <Border Grid.Row="2" x:Name="NotificationBar" Padding="14,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationIcon" Text="✨" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Prêt pour une nouvelle séance" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="NotificationActionButton" Content="Configurer"
                            Visibility="Collapsed" Padding="8,2" Margin="8,0,0,0"
                            Style="{ThemeResource AccentButtonStyle}" FontSize="11"
                            Click="NotificationAction_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusSectionText" Text="Fiche pédagogique" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NotificationDismissButton" Visibility="Collapsed"
                            Style="{ThemeResource SubtleButtonStyle}" Padding="4"
                            Click="NotificationDismiss_Click"
                            AutomationProperties.Name="Fermer la notification">
                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Astuce contextuelle (raccourcis, actions indisponibles…) -->
        <TeachingTip x:Name="ShellHintTip" Grid.Row="1"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True"
                     HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</Window>

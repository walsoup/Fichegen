<Window
    x:Class="FicheGen.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    mc:Ignorable="d"
    Title="PROFstudio">

    <!-- Pas de Background opaque : laisse Mica / Acrylic (voir MainWindow.xaml.cs) visible. -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- ===== Raccourcis clavier (voir aussi Ctrl+, ajouté dans le code) ===== -->
        <Grid.KeyboardAccelerators>
            <!-- Génération & annulation -->
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnCtrlGInvoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscInvoked"/>
            <!-- Volets & actions rapides -->
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnCtrlBInvoked"/>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCtrlNInvoked"/>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCtrlKInvoked"/>
            <KeyboardAccelerator Key="E" Modifiers="Control, Shift" Invoked="OnCtrlShiftEInvoked"/>
            <KeyboardAccelerator Key="W" Modifiers="Control, Shift" Invoked="OnCtrlShiftWInvoked"/>
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnCtrlPInvoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnCtrlFInvoked"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnCtrlZInvoked"/>
            <!-- Navigation entre sections -->
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnCtrlTabInvoked"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control, Shift" Invoked="OnCtrlShiftTabInvoked"/>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <!-- Aide -->
            <KeyboardAccelerator Key="F1" Invoked="OnF1Invoked"/>
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="OnCtrlZeroInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Barre de titre personnalisée (Fluent 2) ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent"
              x:Uid="Shell_TitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo + identité -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="16,0,0,0" Spacing="10">
                <Border Width="30" Height="30" CornerRadius="8"
                        Background="{ThemeResource PROFstudioLogoBrush}">
                    <TextBlock Text="📘" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PROFstudio" FontWeight="SemiBold" FontSize="15" LineHeight="18"
                               AutomationProperties.HeadingLevel="Level1"/>
                </StackPanel>
            </StackPanel>

            <!-- Actions rapides + profil -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="0,0,12,0">

                <ToggleButton x:Name="AssistantToggleButton" CornerRadius="8" Padding="12,5"
                              Click="OnAssistantToggleClicked"
                              x:Uid="Shell_AssistantToggle">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="💬" FontSize="13"/>
                        <TextBlock Text="Assistant" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Button x:Name="ThemeButton" Padding="8,5" CornerRadius="8"
                        Background="Transparent" BorderBrush="Transparent"
                        x:Uid="Shell_ThemeButton">
                    <FontIcon Glyph="&#xE793;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Tag="System" IsChecked="True" Click="OnThemeItemClick"
                                                 x:Uid="Shell_ThemeSystemItem">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE771;"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="ThemeLightItem" Tag="Light" Click="OnThemeItemClick"
                                                 x:Uid="Shell_ThemeLightItem">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE793;"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Tag="Dark" Click="OnThemeItemClick"
                                                 x:Uid="Shell_ThemeDarkItem">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE708;"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="ThemeOledItem" Tag="Oled" Click="OnThemeItemClick"
                                                 x:Uid="Shell_ThemeOledItem" Text="Sombre OLED">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA3B;"/>
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Border Width="1" Height="18" Margin="2,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Profil enseignant -->
                <Button x:Name="ProfileButton" Padding="2" CornerRadius="16"
                        Background="Transparent" BorderBrush="Transparent"
                        x:Uid="Shell_ProfileButton">
                    <PersonPicture x:Name="TeacherPersonPicture" Width="28" Height="28"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="280" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,6,6,10">
                                    <PersonPicture x:Name="TeacherPersonPictureLarge" Width="44" Height="44"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="ProfileNameText" Text="Enseignant·e"
                                                   FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="ProfileSubtext" Text="Vos documents sont enregistrés sur cet ordinateur"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>                                    </StackPanel>
                                </StackPanel>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnProfileSettingsClicked"
                                        x:Uid="Shell_ProfileSettingsButton">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE713;" FontSize="13"/>
                                        <TextBlock Text="Paramètres de l'application" FontSize="12.5" VerticalAlignment="Center"
                                                   x:Uid="Shell_ProfileSettingsLabel"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnProfileShortcutsClicked"
                                        x:Uid="Shell_ProfileShortcutsButton">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE765;" FontSize="13"/>
                                        <TextBlock Text="Raccourcis clavier (F1)" FontSize="12.5" VerticalAlignment="Center"
                                                   x:Uid="Shell_ProfileShortcutsLabel"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnAboutClicked"
                                        x:Uid="Shell_ProfileAboutButton">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE897;" FontSize="13"/>
                                        <TextBlock Text="À propos de PROFstudio" FontSize="12.5" VerticalAlignment="Center"
                                                   x:Uid="Shell_ProfileAboutLabel"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Navigation principale ================= -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="900"
                        ExpandedModeThresholdWidth="1200"
                        OpenPaneLength="260"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="OnNavSelectionChanged"
                        ItemInvoked="OnNavItemInvoked"
                        AutomationProperties.Name="Navigation principale">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="GlobalSearchBox"
                                PlaceholderText="Rechercher un document…"
                                QueryIcon="Find"
                                QuerySubmitted="OnGlobalSearchSubmitted"
                                x:Uid="Shell_GlobalSearchBox"/>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Fiche pédagogique" Tag="FichePage"
                                    x:Uid="Nav_FicheItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Évaluations &amp; Contrôles" Tag="EvaluationPage"
                                    x:Uid="Nav_EvaluationItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Quiz rapides" Tag="QuizPage"
                                    x:Uid="Nav_QuizItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mes documents" Tag="HistoryPage"
                                    x:Uid="Nav_HistoryItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Aide &amp; Raccourcis" Tag="Help" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Aide et raccourcis clavier (F1)"
                                    AutomationProperties.Name="Aide et raccourcis clavier">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Fond opaque : le contenu vit sur une surface solide, la transparence
                 Mica reste réservée à la barre de titre et au volet de navigation
                 (sinon le fond d'écran transparaît de façon incohérente). -->
            <Frame x:Name="ContentFrame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
        </NavigationView>

        <!-- ================= Barre de notification & d'état active (§5.3) ================= -->
        <Border Grid.Row="2" x:Name="NotificationBar" Padding="14,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationIcon" Text="✨" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Prêt pour une nouvelle séance" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               x:Uid="Shell_StatusText"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="NotificationActionButton" Content="Configurer"
                            Visibility="Collapsed" Padding="8,2" Margin="8,0,0,0"
                            Style="{ThemeResource AccentButtonStyle}" FontSize="12"
                            x:Uid="Shell_NotificationAction"
                            Click="NotificationAction_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusSectionText" Text="Fiche pédagogique" FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NotificationDismissButton" Visibility="Collapsed"
                            Style="{ThemeResource SubtleButtonStyle}" Padding="4"
                            Click="NotificationDismiss_Click"
                            x:Uid="Shell_NotificationDismiss">
                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Astuce contextuelle (raccourcis, actions indisponibles…) -->
        <TeachingTip x:Name="ShellHintTip" Grid.Row="1"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True"
                     HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <!-- Palette de commandes (Ctrl+K) : au-dessus de tout le shell -->
        <controls:CommandPalette x:Name="CommandPaletteOverlay" Grid.Row="0" Grid.RowSpan="3"/>
    </Grid>
</Window>

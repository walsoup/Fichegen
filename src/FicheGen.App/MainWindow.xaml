<Window
    x:Class="FicheGen.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PROFstudio">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- ===== Raccourcis clavier (voir aussi Ctrl+, ajouté dans le code) ===== -->
        <Grid.KeyboardAccelerators>
            <!-- Génération & annulation -->
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnCtrlGInvoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscInvoked"/>
            <!-- Volets & actions rapides -->
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnCtrlBInvoked"/>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnCtrlNInvoked"/>
            <KeyboardAccelerator Key="E" Modifiers="Control, Shift" Invoked="OnCtrlShiftEInvoked"/>
            <KeyboardAccelerator Key="W" Modifiers="Control, Shift" Invoked="OnCtrlShiftWInvoked"/>
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnCtrlPInvoked"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnCtrlFInvoked"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnCtrlZInvoked"/>
            <!-- Navigation entre sections -->
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnCtrlTabInvoked"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control, Shift" Invoked="OnCtrlShiftTabInvoked"/>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnCtrlNumberInvoked"/>
            <!-- Aide -->
            <KeyboardAccelerator Key="F1" Invoked="OnF1Invoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Barre de titre personnalisée (Fluent 2) ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent"
              AutomationProperties.Name="Barre de titre PROFstudio">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo + identité -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="14,0,0,0" Spacing="10">
                <Border Width="30" Height="30" CornerRadius="8"
                        Background="{ThemeResource PROFstudioLogoBrush}">
                    <TextBlock Text="📘" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PROFstudio" FontWeight="SemiBold" FontSize="14" LineHeight="17"
                               AutomationProperties.HeadingLevel="Level1"/>
                </StackPanel>
            </StackPanel>

            <!-- Puce dynamique : fournisseur & modèle d'IA -->
            <Button x:Name="AiProviderChip" Grid.Column="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="12,3" CornerRadius="14" MaxWidth="440"
                    Background="{ThemeResource AiChipBackgroundBrush}"
                    BorderBrush="{ThemeResource AiChipBorderBrush}" BorderThickness="1"
                    Click="OnAiChipClicked"
                    AutomationProperties.Name="Fournisseur d'IA actuel — ouvrir les paramètres"
                    ToolTipService.ToolTip="Fournisseur d'IA actif. Cliquer pour configurer (Ctrl+,)">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="AiStatusDot" Width="8" Height="8"
                             Fill="{ThemeResource AiStatusOnlineBrush}"/>
                    <TextBlock x:Name="AiProviderChipText" Text="🤖 Assistant IA" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>

            <!-- Actions rapides + profil -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="0,0,8,0">

                <Button x:Name="NewFicheButton" Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="8" Padding="12,4"
                        Click="OnNewFicheClicked"
                        ToolTipService.ToolTip="Créer une nouvelle fiche (Ctrl+N)"
                        AutomationProperties.Name="Nouvelle fiche">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="Nouvelle fiche" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <ToggleButton x:Name="AssistantToggleButton" CornerRadius="8" Padding="10,4"
                              Click="OnAssistantToggleClicked"
                              ToolTipService.ToolTip="Afficher ou masquer l'Assistant IA (Ctrl+B)"
                              AutomationProperties.Name="Assistant IA — afficher ou masquer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="💬" FontSize="13"/>
                        <TextBlock Text="Assistant" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Border Width="1" Height="20" Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <Button x:Name="SearchButton" Padding="8,4" CornerRadius="8"
                        Background="Transparent" BorderBrush="Transparent"
                        Click="OnSearchClicked"
                        ToolTipService.ToolTip="Rechercher dans l'historique (Ctrl+F)"
                        AutomationProperties.Name="Rechercher">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                </Button>

                <Button x:Name="ThemeButton" Padding="8,4" CornerRadius="8"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="Thème d'affichage : Clair, Sombre ou Système"
                        AutomationProperties.Name="Changer de thème">
                    <FontIcon Glyph="&#xE793;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="🖥️  Système (par défaut)"
                                                 Tag="System" IsChecked="True" Click="OnThemeItemClick"/>
                            <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="☀️  Clair"
                                                 Tag="Light" Click="OnThemeItemClick"/>
                            <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="🌙  Sombre"
                                                 Tag="Dark" Click="OnThemeItemClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="ShortcutsButton" Padding="8,4" CornerRadius="8"
                        Background="Transparent" BorderBrush="Transparent"
                        Click="OnShortcutsClicked"
                        ToolTipService.ToolTip="Raccourcis clavier (F1)"
                        AutomationProperties.Name="Raccourcis clavier">
                    <FontIcon Glyph="&#xE765;" FontSize="14"/>
                </Button>

                <Button x:Name="SettingsButton" Padding="8,4" CornerRadius="8"
                        Background="Transparent" BorderBrush="Transparent"
                        Click="OnSettingsClicked"
                        ToolTipService.ToolTip="Paramètres (Ctrl+,)"
                        AutomationProperties.Name="Paramètres">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                </Button>

                <Border Width="1" Height="20" Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Badge profil enseignant -->
                <Button x:Name="ProfileButton" Padding="2" CornerRadius="16"
                        Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="Profil enseignant"
                        AutomationProperties.Name="Profil enseignant">
                    <PersonPicture x:Name="TeacherPersonPicture" Width="28" Height="28"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="300" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,6,6,10">
                                    <PersonPicture x:Name="TeacherPersonPictureLarge" Width="48" Height="48"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="ProfileNameText" Text="Enseignant·e"
                                                   FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="ProfileSubtext" Text="Compte local — aucune donnée partagée"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnProfileSettingsClicked"
                                        AutomationProperties.Name="Gérer le profil dans les paramètres">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="⚙️" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Gérer le profil (Paramètres)" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnProfileShortcutsClicked"
                                        AutomationProperties.Name="Voir les raccourcis clavier">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="⌨️" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Raccourcis clavier (F1)" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderBrush="Transparent" CornerRadius="6"
                                        Click="OnAboutClicked"
                                        AutomationProperties.Name="À propos de PROFstudio">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="ℹ️" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="À propos de PROFstudio" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Navigation principale ================= -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="1000"
                        ExpandedModeThresholdWidth="1280"
                        OpenPaneLength="280"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="OnNavSelectionChanged"
                        ItemInvoked="OnNavItemInvoked"
                        AutomationProperties.Name="Navigation principale">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="GlobalSearchBox"
                                PlaceholderText="Rechercher une fiche, un quiz…"
                                QueryIcon="Find"
                                QuerySubmitted="OnGlobalSearchSubmitted"
                                ToolTipService.ToolTip="Rechercher dans l'historique (Ctrl+F)"
                                AutomationProperties.Name="Recherche globale"/>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Fiche pédagogique" Tag="FichePage"
                                    ToolTipService.ToolTip="Créer une fiche pédagogique (Ctrl+1)"
                                    AutomationProperties.Name="Fiche pédagogique">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Évaluation" Tag="EvaluationPage"
                                    ToolTipService.ToolTip="Créer une évaluation (Ctrl+2)"
                                    AutomationProperties.Name="Évaluation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Quiz" Tag="QuizPage"
                                    ToolTipService.ToolTip="Créer un quiz interactif (Ctrl+3)"
                                    AutomationProperties.Name="Quiz">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Historique" Tag="HistoryPage"
                                    ToolTipService.ToolTip="Retrouver vos créations (Ctrl+4)"
                                    AutomationProperties.Name="Historique">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Aide et raccourcis" Tag="Help" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Aide et raccourcis clavier (F1)"
                                    AutomationProperties.Name="Aide et raccourcis clavier">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- ================= Barre d'état ================= -->
        <Border Grid.Row="2" Padding="12,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Height="28">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="✨" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Prêt" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Margin="4,0"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <TextBlock x:Name="StatusSectionText" Text="Section : Fiche pédagogique" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="Ctrl+G Générer   •   Ctrl+B Assistant   •   Ctrl+F Rechercher   •   F1 Raccourcis"/>
            </Grid>
        </Border>

        <!-- Astuce contextuelle (raccourcis, actions indisponibles…) -->
        <TeachingTip x:Name="ShellHintTip" Grid.Row="1"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True"
                     HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</Window>

<Page
    x:Class="FicheGen.App.Views.EvaluationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="900">

    <Page.Resources>
        <DataTemplate x:Key="SubjectItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Puce « notion retenue » avec croix de retrait -->
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- AppCommandBar (§6.2) -->
            <RowDefinition Height="*"/>    <!-- Contenu Workspace -->
        </Grid.RowDefinitions>

        <!-- ═══════════ Ligne 0 : Barre de commandes unifiée (§6.2) ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titre de la page -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock x:Uid="EP_Title" Text="Nouvelle évaluation" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock x:Uid="EP_Subtitle" Text="Créez un contrôle avec exercices progressifs et barème de correction."
                           Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>

            <!-- Les commandes du document (zoom, exports, impression, élève/corrigé)
                 vivent désormais uniquement dans la barre d'outils de l'aperçu (PreviewHost). -->

            <!-- Bouton Assistant à droite -->
            <Button Grid.Column="2" x:Name="AssistantToggleButton" Margin="8,0,0,0"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Click="OnToggleAssistantClicked"
                    VerticalAlignment="Center"
                    x:Uid="EP_AssistantToggle">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="✨" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="EP_AssistantLabel" Text="Assistant" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════ Ligne 1 : Workspace 3 colonnes partagé ═══════════ -->
        <controls:CreationWorkspace Grid.Row="1" x:Name="Workspace"
                                    FormWidthSettingsKey="FicheGen.EvaluationPage.FormColumnWidth"
                                    GenerateRequested="GenerateCta_GenerateRequested"
                                    CancelRequested="GenerateCta_CancelRequested">

            <!-- ═══════════ Cartes du formulaire propres à l'Évaluation ═══════════ -->
            <StackPanel Spacing="12">

                <!-- Étape 1 : Classe et Matière -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EP_Step1_Header" Text="1. Classe et Matière" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LevelCombo" x:Uid="EP_LevelCombo" Header="Niveau" HorizontalAlignment="Stretch"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding ClassLevel, Mode=TwoWay}"
                                      SelectionChanged="LevelCombo_SelectionChanged"
                                      AutomationProperties.Name="Niveau scolaire">
                                <ComboBoxItem Content="CP"/>
                                <ComboBoxItem Content="CE1"/>
                                <ComboBoxItem Content="CE2"/>
                                <ComboBoxItem Content="CM1"/>
                                <ComboBoxItem Content="CM2"/>
                                <ComboBoxItem Content="6e"/>
                                <ComboBoxItem Content="5e"/>
                                <ComboBoxItem Content="4e"/>
                                <ComboBoxItem Content="3e"/>
                            </ComboBox>
                            <ComboBox x:Name="SubjectCombo" Grid.Column="1" x:Uid="EP_SubjectCombo" Header="Matière" HorizontalAlignment="Stretch"
                                      IsEditable="True"
                                      PlaceholderText="Sélectionner ou saisir"
                                      ItemTemplate="{StaticResource SubjectItemTemplate}"
                                      Text="{Binding Subject, Mode=TwoWay}"
                                      SelectionChanged="SubjectCombo_SelectionChanged"
                                      TextSubmitted="SubjectCombo_TextSubmitted"
                                      AutomationProperties.Name="Matière"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Étape 2 : Notions ciblées -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EP_Step2_Header" Text="2. Notions à évaluer" Style="{StaticResource CardHeaderStyle}"/>
                        <TextBlock x:Uid="EP_Step2_Sub" Text="Sélectionnez une ou plusieurs notions ou ajoutez votre propre sujet :"
                                   Style="{StaticResource CaptionSecondaryStyle}"/>

                        <ItemsRepeater x:Name="SuggestedLessonsRepeater">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal" MinItemWidth="150" MinColumnSpacing="6" MinRowSpacing="4"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTagBox" x:Uid="EP_NewTagBox"
                                     PlaceholderText="Autre notion… (ex: Calcul d'angles)"
                                     KeyDown="NewTagBox_KeyDown"
                                     TextChanged="NewTagBox_TextChanged"
                                     AutomationProperties.Name="Ajouter une notion"/>
                            <Button x:Name="AddTagButton" Grid.Column="1" x:Uid="EP_AddTagButton" Content="Ajouter"
                                     IsEnabled="False" Click="AddTag_Click"
                                     AutomationProperties.Name="Ajouter la notion"/>
                        </Grid>

                        <ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SelectedChipsPanel" Orientation="Horizontal" Spacing="6"/>
                        </ScrollViewer>

                        <!-- Miroir synchronisé -->
                        <TextBox x:Name="TopicsMirror" Visibility="Collapsed"
                                 Text="{Binding Topics, Mode=TwoWay}"
                                 AutomationProperties.Name="Sujets sélectionnés"/>
                    </StackPanel>
                </Border>

                <!-- Étape 3 : Format & Barème -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="EP_Step3_Header" Text="3. Format et Barème" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="EvalTypeCombo" x:Uid="EP_EvalTypeCombo" Header="Type" HorizontalAlignment="Stretch"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding EvaluationType, Mode=TwoWay}"
                                      AutomationProperties.Name="Type d'évaluation">
                                <ComboBoxItem Tag="formative" Content="🌱 Formative (bilan)"/>
                                <ComboBoxItem Tag="diagnostique" Content="🧭 Diagnostique"/>
                                <ComboBoxItem Tag="sommative" Content="🎓 Sommative (examen)"/>
                            </ComboBox>
                            <NumberBox x:Name="TotalPointsBox" Grid.Column="1" x:Uid="EP_TotalPointsBox" Header="Total points"
                                       Minimum="5" Maximum="100" SmallChange="5" LargeChange="10"
                                       Value="{Binding TotalPoints, Mode=TwoWay}"
                                       ValueChanged="TotalPointsBox_ValueChanged"
                                       AutomationProperties.Name="Total des points"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Niveau de difficulté" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DifficultyLabel" Grid.Column="1" Text="🌳 Intermédiaire"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="DifficultySlider" Minimum="1" Maximum="5" StepFrequency="1" TickFrequency="1"
                                SnapsTo="StepValues"
                                Value="{Binding DifficultyLevel, Mode=TwoWay}"
                                ValueChanged="DifficultySlider_ValueChanged"
                                AutomationProperties.Name="Niveau de difficulté"/>
                    </StackPanel>
                </Border>

                <!-- Étape 4 : Manuel PDF optionnel -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="4. Guide ou manuel PDF (optionnel)" Style="{StaticResource CardHeaderStyle}"/>
                        <controls:PdfDropZone x:Name="PdfDropZoneControl"
                                              GuideFilePath="{Binding GuideFilePath, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:CreationWorkspace>
    </Grid>
</Page>

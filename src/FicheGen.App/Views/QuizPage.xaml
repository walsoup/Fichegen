<Page
    x:Class="FicheGen.App.Views.QuizPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="900">

    <Page.Resources>
        <DataTemplate x:Key="SubjectItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- AppCommandBar (§6.2) -->
            <RowDefinition Height="*"/>    <!-- Contenu Workspace -->
        </Grid.RowDefinitions>

        <!-- ═══════════ Ligne 0 : Barre de commandes unifiée (§6.2) ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <!-- Titre de la page -->
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="PageTitle" x:Uid="QP_Title" Text="Nouveau quiz" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="PageSubtitle" x:Uid="QP_Subtitle" Text="Générez un questionnaire imprimable avec son corrigé détaillé."
                           Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Ligne 1 : Workspace 3 colonnes partagé ═══════════ -->
        <controls:CreationWorkspace Grid.Row="1" x:Name="Workspace"
                                    FormWidthSettingsKey="FicheGen.QuizPage.FormColumnWidth"
                                    GenerateRequested="GenerateCta_GenerateRequested"
                                    CancelRequested="GenerateCta_CancelRequested">

            <!-- ═══════════ Cartes du formulaire propres au Quiz ═══════════ -->
            <StackPanel Spacing="12">

                <!-- Étape 1 : Classe et Matière -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="Step1Header" x:Uid="QP_Step1_Header" Text="1. Classe et Matière" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LevelCombo" x:Uid="QP_LevelCombo" Header="Niveau" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ClassLevels}"
                                      SelectedItem="{Binding ClassLevel, Mode=TwoWay}"
                                      SelectionChanged="LevelCombo_SelectionChanged"
                                      AutomationProperties.Name="Niveau scolaire"/>
                            <ComboBox x:Name="SubjectCombo" Grid.Column="1" x:Uid="QP_SubjectCombo" Header="Matière" HorizontalAlignment="Stretch"
                                      IsEditable="True"
                                      PlaceholderText="Sélectionner ou saisir"
                                      ItemTemplate="{StaticResource SubjectItemTemplate}"
                                      Text="{Binding Subject, Mode=TwoWay}"
                                      SelectionChanged="SubjectCombo_SelectionChanged"
                                      TextSubmitted="SubjectCombo_TextSubmitted"
                                      AutomationProperties.Name="Matière"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Étape 2 : Sujet du quiz -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Step2Header" x:Uid="QP_Step2_Header" Text="2. Sujet du quiz" Style="{StaticResource CardHeaderStyle}"/>
                        <AutoSuggestBox x:Name="TopicBox" x:Uid="QP_TopicBox"
                                        PlaceholderText="ex : Les tables de multiplication, Le cycle de l'eau…"
                                        Text="{Binding Topic, Mode=TwoWay}"
                                        TextChanged="TopicBox_TextChanged"
                                        SuggestionChosen="TopicBox_SuggestionChosen"
                                        QuerySubmitted="TopicBox_QuerySubmitted"
                                        AutomationProperties.Name="Sujet du quiz"/>
                    </StackPanel>
                </Border>

                <!-- Étape 3 : Format et Options -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="Step3Header" x:Uid="QP_Step3_Header" Text="3. Format et Options" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="QuestionCountBox" x:Uid="QP_QuestionCountBox" Header="Questions (3-30)"
                                       Minimum="3" Maximum="30" SmallChange="1" LargeChange="5"
                                       SpinButtonPlacementMode="Inline"
                                       Value="{Binding QuestionCount, Mode=TwoWay}"
                                       ValueChanged="QuizNumberBox_ValueChanged"
                                       AutomationProperties.Name="Nombre de questions"/>
                            <NumberBox x:Name="QuizDurationBox" Grid.Column="1" x:Uid="QP_QuizDurationBox" Header="Durée (minutes)"
                                       Minimum="5" Maximum="60" SmallChange="5" LargeChange="10"
                                       SpinButtonPlacementMode="Inline"
                                       Value="{Binding DurationMinutes, Mode=TwoWay}"
                                       ValueChanged="QuizNumberBox_ValueChanged"
                                       AutomationProperties.Name="Durée du quiz"/>
                        </Grid>

                        <TextBlock x:Name="QuestionTypesHeader" x:Uid="QP_QuestionTypesHeader" Text="Types de questions :" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="QcmCheckBox" Grid.Row="0" Grid.Column="0" x:Uid="QP_QcmCheck" Content="QCM"
                                      IsChecked="{Binding IncludeMultipleChoice, Mode=TwoWay}"
                                      Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                      AutomationProperties.Name="Inclure QCM"/>
                            <CheckBox x:Name="TfCheckBox" Grid.Row="0" Grid.Column="1" x:Uid="QP_TfCheck" Content="Vrai / Faux"
                                      IsChecked="{Binding IncludeTrueFalse, Mode=TwoWay}"
                                      Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                      AutomationProperties.Name="Inclure Vrai/Faux"/>
                            <CheckBox x:Name="ShortCheckBox" Grid.Row="1" Grid.Column="0" x:Uid="QP_ShortCheck" Content="Réponse courte"
                                      IsChecked="{Binding IncludeShortAnswer, Mode=TwoWay}"
                                      Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                      AutomationProperties.Name="Inclure Réponse courte"/>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>

                        <CheckBox x:Name="AnswerKeyCheckbox" x:Uid="QP_AnswerKeyCheck" Content="Inclure le corrigé pour l'enseignant"
                                  IsChecked="{Binding IncludeAnswerKey, Mode=TwoWay}"
                                  Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                  AutomationProperties.Name="Inclure corrigé"/>
                        <CheckBox x:Name="DyslexiaFontCheckbox" x:Uid="QP_DyslexiaFontCheck" Content="Adapter la mise en page (Police DYS)"
                                  IsChecked="{Binding UseDyslexiaFont, Mode=TwoWay}"
                                  Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                  AutomationProperties.Name="Police Dyslexique"/>

                        <!-- Longueur du document (Slider n6) -->
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Longueur / Densité du quiz" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding DocumentLengthLabel}" FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1"
                                    SnapsTo="StepValues"
                                    Value="{Binding DocumentLengthIndex, Mode=TwoWay}"
                                    AutomationProperties.Name="Longueur du quiz"/>
                            <Grid Margin="2,-4,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bref" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Raccourci" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Défaut" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Long" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Détaillé" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Exhaustif" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Étape 4 : Manuel PDF optionnel -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Step4Header" x:Uid="QP_Step4_Header" Text="4. Guide ou manuel PDF (optionnel)" Style="{StaticResource CardHeaderStyle}"/>
                        <controls:PdfDropZone x:Name="PdfDropZoneControl"
                                              GuideFilePath="{Binding GuideFilePath, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:CreationWorkspace>
    </Grid>
</Page>

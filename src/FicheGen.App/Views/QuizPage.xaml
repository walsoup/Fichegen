<Page
    x:Class="FicheGen.App.Views.QuizPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="900">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <DataTemplate x:Key="SubjectItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates" CurrentStateChanged="AdaptiveStates_CurrentStateChanged">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AssistantColumn.Width" Value="360"/>
                        <Setter Target="AssistantOverlay.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AssistantColumn.Width" Value="0"/>
                        <Setter Target="AssistantFab.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FormColumn" Width="400" MinWidth="340" MaxWidth="560"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="420"/>
            <ColumnDefinition x:Name="AssistantColumn" Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Colonne 0 : Formulaire ═══════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0">
            <StackPanel x:Name="FormPanel" Spacing="14" Margin="0,0,0,8">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- En-tête -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AccentFillColorTertiaryBrush}">
                        <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Quiz" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Text="Générez un quiz rapide à imprimer, avec corrigé détaillé et options de lisibilité."
                                   Style="{StaticResource CaptionSecondaryStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Classe et sujet -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="Classe et sujet" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <ComboBox x:Name="LevelCombo" Header="Niveau" HorizontalAlignment="Stretch"
                              SelectedValue="{Binding ClassLevel, Mode=TwoWay}"
                              SelectionChanged="LevelCombo_SelectionChanged"
                              AutomationProperties.Name="Niveau scolaire">
                        <x:String>CP</x:String>
                        <x:String>CE1</x:String>
                        <x:String>CE2</x:String>
                        <x:String>CM1</x:String>
                        <x:String>CM2</x:String>
                        <x:String>6e</x:String>
                        <x:String>5e</x:String>
                        <x:String>4e</x:String>
                        <x:String>3e</x:String>
                        <x:String>Seconde</x:String>
                        <x:String>Première</x:String>
                        <x:String>Terminale</x:String>
                    </ComboBox>

                    <ComboBox x:Name="SubjectCombo" Header="Matière" HorizontalAlignment="Stretch"
                              IsEditable="True"
                              PlaceholderText="Choisir ou saisir une matière"
                              ItemTemplate="{StaticResource SubjectItemTemplate}"
                              Text="{Binding Subject, Mode=TwoWay}"
                              SelectionChanged="SubjectCombo_SelectionChanged"
                              TextSubmitted="SubjectCombo_TextSubmitted"
                              AutomationProperties.Name="Matière"/>

                    <AutoSuggestBox x:Name="TopicBox" Header="Sujet du quiz"
                                    PlaceholderText="ex : Les tables de multiplication, Le cycle de l'eau…"
                                    QueryIcon="Find"
                                    Text="{Binding Topic, Mode=TwoWay}"
                                    TextChanged="TopicBox_TextChanged"
                                    SuggestionChosen="TopicBox_SuggestionChosen"
                                    QuerySubmitted="TopicBox_QuerySubmitted"
                                    AutomationProperties.Name="Sujet du quiz"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="QuestionCountBox" Header="Questions (3-30)"
                                   Minimum="3" Maximum="30" SmallChange="1" LargeChange="5"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{Binding QuestionCount, Mode=TwoWay}"
                                   ValueChanged="QuizField_ValueChanged"
                                   AutomationProperties.Name="Nombre de questions"/>
                        <NumberBox x:Name="QuizDurationBox" Grid.Column="1" Header="Durée (5-30 min)"
                                   Minimum="5" Maximum="30" SmallChange="5" LargeChange="10"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{Binding DurationMinutes, Mode=TwoWay}"
                                   ValueChanged="QuizField_ValueChanged"
                                   AutomationProperties.Name="Durée du quiz en minutes"/>
                    </Grid>
                </StackPanel>

                <!-- Types de questions -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="Types de questions" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Content="QCM (Choix multiple)"
                                  IsChecked="{Binding IncludeMultipleChoice, Mode=TwoWay}"
                                  Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                  AutomationProperties.Name="Inclure QCM"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="Vrai / Faux"
                                  IsChecked="{Binding IncludeTrueFalse, Mode=TwoWay}"
                                  Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                  AutomationProperties.Name="Inclure Vrai/Faux"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="Réponse courte"
                                  IsChecked="{Binding IncludeShortAnswer, Mode=TwoWay}"
                                  Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                  AutomationProperties.Name="Inclure Réponse courte"/>
                    </Grid>
                </StackPanel>

                <!-- Options supplémentaires -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="Options de mise en page" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                    <CheckBox x:Name="AnswerKeyCheckbox" Content="Inclure le corrigé à la fin"
                              IsChecked="{Binding IncludeAnswerKey, Mode=TwoWay}"
                              Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                              AutomationProperties.Name="Inclure corrigé"/>
                    <CheckBox x:Name="DyslexiaFontCheckbox" Content="Formater avec la police DYS"
                              IsChecked="{Binding UseDyslexiaFont, Mode=TwoWay}"
                              Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                              AutomationProperties.Name="Police Dyslexique"/>
                </StackPanel>

                <!-- Guide PDF -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="Guide pédagogique (PDF)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <controls:PdfDropZone x:Name="PdfDropZoneControl"
                                          GuideFilePath="{Binding ResultViewModel.GuideFilePath, Mode=TwoWay}"
                                          Tapped="PdfDropZoneControl_Tapped"
                                          Drop="PdfDropZoneControl_Drop"/>
                </StackPanel>

                <!-- Bannière d'information -->
                <InfoBar x:Name="FormInfoBar" IsOpen="False" Severity="Informational" Margin="0,4,0,0"/>

                <!-- Actions -->
                <controls:GenerateButton x:Name="GenButton"
                                         ButtonText="Générer le quiz (Ctrl+G)"
                                         IsGenerating="{Binding IsGenerating}"
                                         Command="{Binding GenerateQuizCommand}"
                                         CancelCommand="{Binding CancelGenerationCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Séparateur de formulaire redimensionnable -->
        <Grid x:Name="SplitterGrip" Grid.Column="0" Width="4" Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}"
              CornerRadius="2" Opacity="0.45" HorizontalAlignment="Right" Margin="0,0,2,0" IsHitTestVisible="False"/>

        <toolkit:GridSplitter Grid.Column="0" Width="8" ResizeBehavior="BasedOnAlignment"
                              ResizeDirection="Columns" HorizontalAlignment="Right" Background="Transparent"
                              PointerEntered="FormSplitter_PointerEntered" PointerExited="FormSplitter_PointerExited"
                              PointerCaptureLost="FormSplitter_PointerCaptureLost"/>


        <!-- ═══════════ Colonne 1 : Aperçu du document ═══════════ -->
        <controls:PreviewHost Grid.Column="1" Margin="8,0,8,0" DataContext="{Binding ResultViewModel}"/>

        <!-- ═══════════ Colonne 2 : Assistant IA ═══════════ -->
        <!-- En mode large, il est intégré sur le côté. En mode étroit, il est dans l'overlay -->
        <Grid Grid.Column="2" x:Name="AssistantInlineHost">
            <controls:AssistantPane x:Name="AssistantPaneControl"/>
        </Grid>

        <!-- Bouton flottant de l'assistant (mode étroit uniquement) -->
        <Button x:Name="AssistantFab"
                Grid.Column="1"
                Width="56"
                Height="56"
                CornerRadius="28"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Foreground="White"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Visibility="Collapsed"
                Click="AssistantFab_Click"
                ToolTipService.ToolTip="Afficher l'assistant IA (Ctrl+B)"
                AutomationProperties.Name="Ouvrir l'assistant IA">
            <FontIcon Glyph="&#xE99A;" FontSize="20"/>
        </Button>

        <!-- Overlay de l'assistant (mode étroit uniquement) -->
        <Grid x:Name="AssistantOverlay" Grid.ColumnSpan="3" Visibility="Collapsed" Canvas.ZIndex="100">
            <!-- Arrière-plan flouté sombre et cliquable -->
            <Border x:Name="OverlayBackdrop" Background="#7F000000" Tapped="OverlayBackdrop_Tapped"/>

            <!-- Tiroir latéral droit -->
            <Grid x:Name="OverlayHost" Width="360" HorizontalAlignment="Right" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="OverlayClose"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Margin="12"
                        Click="OverlayClose_Click"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Fermer l'assistant IA">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        <TextBlock Text="Fermer" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ═══════════ Barre d'état (bas de page) ═══════════ -->
        <controls:StatusBar Grid.ColumnSpan="3" VerticalAlignment="Bottom" Canvas.ZIndex="200"
                            StatusMessage="{Binding StatusMessage}"
                            IsBusy="{Binding IsGenerating}"/>
    </Grid>
</Page>

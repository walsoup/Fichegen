<Page
    x:Class="FicheGen.App.Views.QuizPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="900">

    <Page.Resources>
        <DataTemplate x:Key="SubjectItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- AppCommandBar (§6.2) -->
            <RowDefinition Height="*"/>    <!-- Contenu Workspace -->
        </Grid.RowDefinitions>

        <!-- ═══════════ Ligne 0 : Barre de commandes unifiée (§6.2) ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titre de la page -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock Text="Nouveau quiz" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="Générez un questionnaire imprimable avec son corrigé détaillé."
                           Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>

            <!-- CommandBar persistante -->
            <CommandBar Grid.Column="1" HorizontalAlignment="Right" DefaultLabelPosition="Right"
                        Background="Transparent" BorderThickness="0" IsOpen="False">
                <!-- Groupe Primaire : Générer / Annuler -->
                <AppBarButton x:Name="CmdGenerate" Label="Générer (Ctrl+G)" Icon="Play"
                              Command="{Binding GenerateQuizCommand}"
                              ToolTipService.ToolTip="Lancer la rédaction du quiz par l'assistant IA (Ctrl+G)"/>

                <AppBarButton x:Name="CmdCancel" Label="Annuler" Icon="Stop"
                              Command="{Binding CancelGenerationCommand}"
                              Visibility="Collapsed"
                              ToolTipService.ToolTip="Arrêter la génération en cours"/>

                <AppBarSeparator/>

                <!-- Groupe Vue & Format -->
                <AppBarButton x:Name="CmdStudentView"
                              Label="{Binding ResultViewModel.StudentViewButtonLabel, FallbackValue='Version Élève'}"
                              Command="{Binding ResultViewModel.ToggleStudentViewCommand}"
                              ToolTipService.ToolTip="Basculer entre la version élève et le corrigé">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton x:Name="CmdZoomOut" Label="Zoom -" Icon="ZoomOut"
                              Command="{Binding ResultViewModel.ZoomOutCommand}"
                              ToolTipService.ToolTip="Réduire l'affichage"/>

                <AppBarButton x:Name="CmdZoomIn" Label="Zoom +" Icon="ZoomIn"
                              Command="{Binding ResultViewModel.ZoomInCommand}"
                              ToolTipService.ToolTip="Agrandir l'affichage"/>

                <AppBarSeparator/>

                <!-- Groupe Exportation -->
                <AppBarButton x:Name="CmdExportDocx" Label="Word" Icon="Document"
                              Command="{Binding ResultViewModel.ExportDocxCommand}"
                              ToolTipService.ToolTip="Exporter au format Microsoft Word (.docx)"/>

                <AppBarButton x:Name="CmdExportPdf" Label="PDF" Icon="OpenFile"
                              Command="{Binding ResultViewModel.ExportPdfCommand}"
                              ToolTipService.ToolTip="Exporter au format PDF imprimable"/>

                <AppBarButton x:Name="CmdPrint" Label="Imprimer" Icon="Print"
                              Command="{Binding ResultViewModel.PrintCommand}"
                              ToolTipService.ToolTip="Imprimer le quiz (Ctrl+P)"/>

                <!-- Commandes secondaires dans le menu dépassement (⋯) -->
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Exporter en RTF" Icon="Document"
                                  Command="{Binding ResultViewModel.ExportRtfCommand}"/>
                    <AppBarButton Label="Copier le texte brut" Icon="Copy"
                                  Command="{Binding ResultViewModel.CopyPlainTextCommand}"/>
                    <AppBarButton Label="Rechercher dans le document" Icon="Find"
                                  Command="{Binding ResultViewModel.ToggleFindBarCommand}"/>
                    <AppBarSeparator/>
                    <AppBarButton Label="Ouvrir le dossier d'exportation" Icon="Folder"
                                  Command="{Binding ResultViewModel.OpenLastExportedFolderCommand}"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <!-- Bouton Assistant à droite -->
            <Button Grid.Column="2" x:Name="AssistantToggleButton" Margin="8,0,0,0"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Click="OnToggleAssistantClicked"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Afficher ou masquer l'assistant IA latéral">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="✨" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Assistant" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════ Ligne 1 : Workspace 3 colonnes ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FormColumn" Width="380" MinWidth="320" MaxWidth="560"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="400"/>
                <ColumnDefinition x:Name="AssistantColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ Colonne 0 : Formulaire de création ═══════════ -->
            <ScrollViewer Grid.Column="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                <StackPanel x:Name="FormPanel" Spacing="12" Margin="0,0,0,12">

                    <!-- Étape 1 : Classe et Matière -->
                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="1. Classe et Matière" Style="{StaticResource CardHeaderStyle}"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LevelCombo" Header="Niveau" HorizontalAlignment="Stretch"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding ClassLevel, Mode=TwoWay}"
                                          SelectionChanged="LevelCombo_SelectionChanged"
                                          AutomationProperties.Name="Niveau scolaire">
                                    <ComboBoxItem Content="CP"/>
                                    <ComboBoxItem Content="CE1"/>
                                    <ComboBoxItem Content="CE2"/>
                                    <ComboBoxItem Content="CM1"/>
                                    <ComboBoxItem Content="CM2"/>
                                    <ComboBoxItem Content="6e"/>
                                    <ComboBoxItem Content="5e"/>
                                    <ComboBoxItem Content="4e"/>
                                    <ComboBoxItem Content="3e"/>
                                </ComboBox>
                                <ComboBox x:Name="SubjectCombo" Grid.Column="1" Header="Matière" HorizontalAlignment="Stretch"
                                          IsEditable="True"
                                          PlaceholderText="Sélectionner ou saisir"
                                          ItemTemplate="{StaticResource SubjectItemTemplate}"
                                          Text="{Binding Subject, Mode=TwoWay}"
                                          SelectionChanged="SubjectCombo_SelectionChanged"
                                          TextSubmitted="SubjectCombo_TextSubmitted"
                                          AutomationProperties.Name="Matière"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Étape 2 : Sujet du quiz -->
                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="2. Sujet du quiz" Style="{StaticResource CardHeaderStyle}"/>
                            <AutoSuggestBox x:Name="TopicBox"
                                            PlaceholderText="ex : Les tables de multiplication, Le cycle de l'eau…"
                                            Text="{Binding Topic, Mode=TwoWay}"
                                            TextChanged="TopicBox_TextChanged"
                                            SuggestionChosen="TopicBox_SuggestionChosen"
                                            QuerySubmitted="TopicBox_QuerySubmitted"
                                            AutomationProperties.Name="Sujet du quiz"/>
                        </StackPanel>
                    </Border>

                    <!-- Étape 3 : Format et Options -->
                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="3. Format et Options" Style="{StaticResource CardHeaderStyle}"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="QuestionCountBox" Header="Questions (3-30)"
                                           Minimum="3" Maximum="30" SmallChange="1" LargeChange="5"
                                           SpinButtonPlacementMode="Inline"
                                           Value="{Binding QuestionCount, Mode=TwoWay}"
                                           ValueChanged="QuizNumberBox_ValueChanged"
                                           AutomationProperties.Name="Nombre de questions"/>
                                <NumberBox x:Name="QuizDurationBox" Grid.Column="1" Header="Durée (minutes)"
                                           Minimum="5" Maximum="60" SmallChange="5" LargeChange="10"
                                           SpinButtonPlacementMode="Inline"
                                           Value="{Binding DurationMinutes, Mode=TwoWay}"
                                           ValueChanged="QuizNumberBox_ValueChanged"
                                           AutomationProperties.Name="Durée du quiz"/>
                            </Grid>

                            <TextBlock Text="Types de questions :" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="QCM"
                                          IsChecked="{Binding IncludeMultipleChoice, Mode=TwoWay}"
                                          Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                          AutomationProperties.Name="Inclure QCM"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="Vrai / Faux"
                                          IsChecked="{Binding IncludeTrueFalse, Mode=TwoWay}"
                                          Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                          AutomationProperties.Name="Inclure Vrai/Faux"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Réponse courte"
                                          IsChecked="{Binding IncludeShortAnswer, Mode=TwoWay}"
                                          Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                          AutomationProperties.Name="Inclure Réponse courte"/>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>

                            <CheckBox x:Name="AnswerKeyCheckbox" Content="Inclure le corrigé pour l'enseignant"
                                      IsChecked="{Binding IncludeAnswerKey, Mode=TwoWay}"
                                      Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                      AutomationProperties.Name="Inclure corrigé"/>
                            <CheckBox x:Name="DyslexiaFontCheckbox" Content="Adapter la mise en page (Police DYS)"
                                      IsChecked="{Binding UseDyslexiaFont, Mode=TwoWay}"
                                      Checked="QuizField_ValueChanged" Unchecked="QuizField_ValueChanged"
                                      AutomationProperties.Name="Police Dyslexique"/>
                        </StackPanel>
                    </Border>

                    <!-- Étape 4 : Manuel PDF optionnel -->
                    <Border Style="{StaticResource FormCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="4. Guide ou manuel PDF (optionnel)" Style="{StaticResource CardHeaderStyle}"/>
                            <controls:PdfDropZone x:Name="PdfDropZoneControl"
                                                  GuideFilePath="{Binding GuideFilePath, Mode=TwoWay}"
                                                  Tapped="PdfDropZoneControl_Tapped"
                                                  Drop="PdfDropZoneControl_Drop"/>
                        </StackPanel>
                    </Border>

                    <!-- Validation en ligne -->
                    <InfoBar x:Name="FormInfoBar" IsOpen="False" Severity="Informational" Margin="0,2,0,0"
                             AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Séparateur redimensionnable -->
            <Border x:Name="SplitterGrip" Grid.Column="0" Width="4" Height="36" CornerRadius="2" Opacity="0.45"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False"/>

            <toolkit:GridSplitter x:Name="FormSplitter" Grid.Column="0"
                                  Width="14" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                                  AutomationProperties.Name="Redimensionner les panneaux"
                                  PointerEntered="FormSplitter_PointerEntered"
                                  PointerExited="FormSplitter_PointerExited"
                                  PointerCaptureLost="FormSplitter_PointerCaptureLost"/>

            <!-- ═══════════ Colonne 1 : Aperçu du document ═══════════ -->
            <controls:PreviewHost Grid.Column="1" DataContext="{Binding ResultViewModel}"/>

            <!-- ═══════════ Colonne 2 : Assistant IA ═══════════ -->
            <Grid Grid.Column="2" x:Name="AssistantInlineHost">
                <controls:AssistantPane x:Name="AssistantPaneControl"/>
            </Grid>

            <!-- Bouton flottant Assistant (petit écran) -->
            <Button x:Name="AssistantFab" Grid.Column="1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20" Visibility="Collapsed"
                    Style="{ThemeResource AccentButtonStyle}" CornerRadius="22" Padding="16,10"
                    Click="AssistantFab_Click"
                    AutomationProperties.Name="Ouvrir l'assistant pédagogique"
                    ToolTipService.ToolTip="Poser une question à l'assistant IA">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="✨" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Assistant" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Assistant en superposition (petit écran) -->
            <Grid x:Name="AssistantOverlay" Grid.ColumnSpan="3" Visibility="Collapsed">
                <Border Background="{ThemeResource ScrimBrush}" Tapped="OverlayBackdrop_Tapped"/>
                <Border HorizontalAlignment="Right" Width="380"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="✨" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Assistant pédagogique" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="OverlayCloseButton"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6"
                                    Click="OverlayClose_Click"
                                    AutomationProperties.Name="Fermer l'assistant"
                                    ToolTipService.ToolTip="Fermer">
                                <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                            </Button>
                        </Grid>
                        <Grid x:Name="OverlayHost" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

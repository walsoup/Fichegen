<Page
    x:Class="FicheGen.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    xmlns:local="using:FicheGen.App.Views"
    xmlns:vm="using:FicheGen.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- Style « puce » pour les filtres (anneau de focus système conservé) -->
            <Style x:Key="FilterChipRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualMargin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chip"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="17">
                                <ContentPresenter x:Name="ChipContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="Chip.BorderBrush" Value="Transparent"/>
                                            <Setter Target="ChipContent.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pilules de statistiques -->
            <Style x:Key="StatPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="12,5"/>
            </Style>

            <!-- Pilules de métadonnées (niveau, type) -->
            <Style x:Key="MetaPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,1"/>
            </Style>

            <!-- Conteneur de groupe : template nu SANS états de survol/sélection —
                 sinon le rectangle de survol couvre toute la journée au lieu de la
                 carte survolée. Le survol est géré par carte dans le modèle d'élément. -->
            <Style x:Key="HistoryGroupContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style pour les éléments de l'historique -->
            <Style x:Key="HistoryItemContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête serein -->
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,16">
            <TextBlock x:Name="PageTitle" x:Uid="HP_Title" Text="Mes documents" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock x:Name="PageSubtitle" x:Uid="HP_Subtitle" Text="Retrouvez toutes vos fiches, évaluations et quiz sauvegardés automatiquement sur cet ordinateur."
                       Style="{StaticResource CaptionSecondaryStyle}"/>
        </StackPanel>

        <!-- Barre de recherche -->
        <AutoSuggestBox x:Name="SearchBox" x:Uid="HP_SearchBox"
                        Grid.Row="1"
                        Margin="0,0,0,12"
                        PlaceholderText="Rechercher par titre, matière, niveau ou mot-clé…"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        QueryIcon="Find"/>

        <!-- Filtres par type -->
        <RadioButtons x:Name="FilterRadioButtons"
                      Grid.Row="2"
                      Margin="0,0,0,16"
                      HorizontalAlignment="Left"
                      MaxColumns="5"
                      SelectedIndex="0"
                      SelectionChanged="OnFilterSelectionChanged">
            <RadioButton x:Name="FilterAll" x:Uid="HP_FilterAll" Content="Tout" Tag="all"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton x:Name="FilterFiches" x:Uid="HP_FilterFiches" Content="Fiches" Tag="fiche"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton x:Name="FilterEvals" x:Uid="HP_FilterEvals" Content="Évaluations" Tag="evaluation"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton x:Name="FilterQuiz" x:Uid="HP_FilterQuiz" Content="Quiz" Tag="quiz"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton x:Name="FilterFavorites" x:Uid="HP_FilterFavorites" Content="Favoris" Tag="favorite"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
        </RadioButtons>

        <!-- Indicateur de chargement -->
        <ProgressRing Grid.Row="3"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- État vide pédagogique -->
        <StackPanel Grid.Row="3"
                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ShowEmptyState), Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="440"
                    Margin="24"
                    x:Uid="HP_EmptyState">
            <Border Width="80" Height="80" CornerRadius="20" HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <FontIcon FontFamily="Segoe MDL2 Assets"
                          Glyph="&#xE8A5;"
                          FontSize="34"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       FontWeight="SemiBold"
                       TextAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <Border Padding="14"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="0,6,0,0">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="💡" FontSize="13" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Uid="HP_Tip1" Text="Chaque fiche, évaluation ou quiz généré est sauvegardé automatiquement ici."
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔍" FontSize="13" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Uid="HP_Tip2" Text="Utilisez la recherche pour retrouver rapidement un document par matière, niveau ou mot-clé."
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Contenu principal - Liste des éléments -->
        <ScrollViewer x:Name="ResultsScrollViewer" Grid.Row="3"
                      Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}">
            <StackPanel>
                <!-- Statistiques -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource StatPillStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.StatsTotalDisplay, Mode=OneWay}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource StatPillStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.StatsMonthDisplay, Mode=OneWay}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource StatPillStyle}">
                        <TextBlock Text="{x:Bind ViewModel.StatsFavoritesDisplay, Mode=OneWay}" FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Liste groupée -->
                <ListView ItemsSource="{x:Bind ViewModel.GroupedItems, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemContainerStyle="{StaticResource HistoryGroupContainerStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryGroupViewModel">
                            <StackPanel>
                                <!-- En-tête de groupe -->
                                <TextBlock Text="{x:Bind Header}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                
                                <!-- Éléments du groupe -->
                                <ItemsControl ItemsSource="{x:Bind Items}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                            <Border Style="{StaticResource HistoryItemContainerStyle}"
                                                    Margin="0,0,0,8"
                                                    Tapped="OnItemClicked"
                                                    KeyDown="OnItemKeyDown"
                                                    PointerEntered="OnItemPointerEntered"
                                                    PointerExited="OnItemPointerExited"
                                                    IsTabStop="True"
                                                    Tag="{Binding}"
                                                    AutomationProperties.Name="{x:Bind Title}"
                                                    AutomationProperties.HelpText="{x:Bind TypeDisplay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Icône de type -->
                                                    <TextBlock Grid.Column="0" 
                                                               Grid.Row="0"
                                                               Text="{x:Bind TypeEmoji}"
                                                               FontSize="20"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Titre et métadonnées -->
                                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Style="{StaticResource MetaPillStyle}" Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind TypeDisplay}" FontSize="12"/>
                                                            </Border>
                                                            <Border Style="{StaticResource MetaPillStyle}" Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind LevelBadge}" FontSize="12"/>
                                                            </Border>
                                                            <TextBlock Text="{x:Bind CreatedTimeDisplay}"
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Extrait de recherche -->
                                                    <TextBlock Grid.Column="1"
                                                               Grid.Row="1"
                                                               Text="{x:Bind Snippet}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind local:HistoryPage.BoolToVisibility(HasSnippet), Mode=OneWay}"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Boutons d'action (§8.2) -->
                                                    <StackPanel Grid.Column="2" 
                                                                Grid.Row="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{ThemeResource SubtleButtonStyle}"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Content="{x:Bind FavoriteGlyph, Mode=OneWay}"
                                                                ToolTipService.ToolTip="{x:Bind FavoriteText, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind FavoriteText, Mode=OneWay}"
                                                                Tag="{Binding}"
                                                                Click="OnFavoriteClicked"
                                                                Margin="0,0,4,0"/>
                                                        
                                                        <Button Style="{ThemeResource SubtleButtonStyle}"
                                                                x:Uid="HP_OptionsButton" ToolTipService.ToolTip="Options du document (⋯)" AutomationProperties.Name="Options du document"
                                                                Tag="{Binding}">
                                                            <FontIcon Glyph="&#xE712;" FontSize="12"/>
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                     <MenuFlyoutItem x:Uid="HP_MenuOpen" Text="Ouvrir le document" Click="OnOpenMenuItemClicked" Tag="{Binding}">
                                                                         <MenuFlyoutItem.Icon>
                                                                             <FontIcon Glyph="&#xE8E5;"/>
                                                                         </MenuFlyoutItem.Icon>
                                                                     </MenuFlyoutItem>
                                                                     <MenuFlyoutItem x:Uid="HP_MenuRename" Text="Renommer" Click="OnRenameMenuItemClicked" Tag="{Binding}">
                                                                         <MenuFlyoutItem.Icon>
                                                                             <FontIcon Glyph="&#xE8AC;"/>
                                                                         </MenuFlyoutItem.Icon>
                                                                     </MenuFlyoutItem>
                                                                     <MenuFlyoutItem x:Uid="HP_MenuExportWord" Text="Exporter en Word (.docx)" Click="OnExportWordMenuItemClicked" Tag="{Binding}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE8A5;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutItem x:Uid="HP_MenuExportPdf" Text="Exporter en PDF" Click="OnExportPdfMenuItemClicked" Tag="{Binding}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xEA90;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutSeparator/>
                                                                    <MenuFlyoutItem x:Uid="HP_MenuDelete" Text="Supprimer le document" Click="OnDeleteClicked" Tag="{Binding}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE74D;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast d'annulation de suppression (§8.3) -->
        <Border x:Name="UndoToast" Grid.Row="0" Grid.RowSpan="4"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="16,10" CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="UndoToastText" x:Uid="HP_UndoToastDefault" Text="Document supprimé" FontSize="13" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="UndoToastButton" x:Uid="HP_UndoButton" Content="Annuler" Style="{ThemeResource AccentButtonStyle}"
                        Padding="12,4" FontSize="12" Click="OnUndoDeleteClicked"/>
                <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6" Click="OnDismissUndoClicked">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
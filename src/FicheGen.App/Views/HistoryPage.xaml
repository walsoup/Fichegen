<Page
    x:Class="FicheGen.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    xmlns:local="using:FicheGen.App.Views"
    xmlns:converters="using:FicheGen.App.Converters"
    xmlns:vm="using:FicheGen.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>

            <!-- Prise en charge du contraste élevé pour les ressources personnalisées -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="HistoryChipBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush"/>
                    <StaticResource x:Key="HistoryChipBackgroundPointerOverBrush" ResourceKey="SubtleFillColorSecondaryBrush"/>
                    <StaticResource x:Key="HistoryChipBackgroundCheckedBrush" ResourceKey="AccentFillColorDefaultBrush"/>
                    <StaticResource x:Key="HistoryChipCheckedForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
                    <StaticResource x:Key="HistoryChipBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HistoryChipBackgroundBrush" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HistoryChipBackgroundPointerOverBrush" Color="#FF202020"/>
                    <SolidColorBrush x:Key="HistoryChipBackgroundCheckedBrush" Color="#FF1AEBFF"/>
                    <SolidColorBrush x:Key="HistoryChipCheckedForegroundBrush" Color="#FF000000"/>
                    <SolidColorBrush x:Key="HistoryChipBorderBrush" Color="#FFFFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Convertisseurs -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisInverted" IsInverted="True"/>

            <!-- Style « puce » pour les filtres (anneau de focus système conservé) -->
            <Style x:Key="FilterChipRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{ThemeResource HistoryChipBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource HistoryChipBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualMargin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chip"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="17">
                                <ContentPresenter x:Name="ChipContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource HistoryChipBackgroundPointerOverBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource HistoryChipBackgroundCheckedBrush}"/>
                                            <Setter Target="Chip.BorderBrush" Value="Transparent"/>
                                            <Setter Target="ChipContent.Foreground" Value="{ThemeResource HistoryChipCheckedForegroundBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pilules de statistiques -->
            <Style x:Key="StatPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="12,5"/>
            </Style>

            <!-- Pilules de métadonnées (niveau, type) -->
            <Style x:Key="MetaPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,1"/>
            </Style>

            <!-- Conteneur de groupe discret -->
            <Style x:Key="HistoryGroupContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Style pour les éléments de l'historique -->
            <Style x:Key="HistoryItemContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de recherche -->
        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        PlaceholderText="Rechercher dans l'historique..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        QueryIcon="Find"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisInverted}}"/>

        <!-- Filtres par type -->
        <RadioButtons x:Name="FilterRadioButtons"
                      Grid.Row="1"
                      Margin="0,0,0,12"
                      MaxColumns="5"
                      SelectionChanged="OnFilterSelectionChanged"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisInverted}}">
            <RadioButton Content="Tout" 
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Fiches"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Évaluations"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Quiz"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Favoris"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
        </RadioButtons>

        <!-- Indicateur de chargement -->
        <ProgressRing Grid.Row="2"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- État vide -->
        <StackPanel Grid.Row="2"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <FontIcon FontFamily="Segoe MDL2 Assets"
                      Glyph="&#xE74D;"
                      FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Margin="0,0,0,12"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextAlignment="Center"
                      MaxWidth="400"/>
        </StackPanel>

        <!-- Contenu principal - Liste des éléments -->
        <ScrollViewer Grid.Row="2"
                      Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Statistiques -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource StatPillStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.StatsTotalDisplay}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource StatPillStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.StatsMonthDisplay}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource StatPillStyle}">
                        <TextBlock Text="{x:Bind ViewModel.StatsFavoritesDisplay}" FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Liste groupée -->
                <ListView ItemsSource="{x:Bind ViewModel.GroupedItems}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemContainerStyle="{StaticResource HistoryGroupContainerStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryGroupViewModel">
                            <StackPanel>
                                <!-- En-tête de groupe -->
                                <TextBlock Text="{x:Bind Header}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                
                                <!-- Éléments du groupe -->
                                <ItemsControl ItemsSource="{x:Bind Items}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                            <Border Style="{StaticResource HistoryItemContainerStyle}" 
                                                    Margin="0,0,0,8"
                                                    Tapped="OnItemClicked"
                                                    Tag="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Icône de type -->
                                                    <TextBlock Grid.Column="0" 
                                                               Grid.Row="0"
                                                               Text="{x:Bind TypeEmoji}"
                                                               FontSize="20"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Titre et métadonnées -->
                                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Style="{StaticResource MetaPillStyle}" Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind TypeDisplay}" FontSize="11"/>
                                                            </Border>
                                                            <Border Style="{StaticResource MetaPillStyle}" Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind LevelBadge}" FontSize="11"/>
                                                            </Border>
                                                            <TextBlock Text="{x:Bind CreatedTimeDisplay}"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Extrait de recherche -->
                                                    <TextBlock Grid.Column="1"
                                                               Grid.Row="1"
                                                               Text="{x:Bind Snippet}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind HasSnippet, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Boutons d'action -->
                                                    <StackPanel Grid.Column="2" 
                                                                Grid.Row="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{ThemeResource SubtleButtonStyle}"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Content="{x:Bind FavoriteGlyph}"
                                                                ToolTipService.ToolTip="{x:Bind FavoriteText}"
                                                                Tag="{Binding}"
                                                                Click="OnFavoriteClicked"
                                                                Margin="0,0,4,0"/>
                                                        <Button Style="{ThemeResource SubtleButtonStyle}"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Content="&#xE74D;"
                                                                ToolTipService.ToolTip="Supprimer"
                                                                Tag="{Binding}"
                                                                Click="OnDeleteClicked"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
<Page
    x:Class="FicheGen.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    xmlns:local="using:FicheGen.App.Views"
    xmlns:vm="using:FicheGen.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- Style « puce » pour les filtres (anneau de focus système conservé) -->
            <Style x:Key="FilterChipRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="FocusVisualMargin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Chip"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="17">
                                <ContentPresenter x:Name="ChipContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Chip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="Chip.BorderBrush" Value="Transparent"/>
                                            <Setter Target="ChipContent.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pilules de statistiques -->
            <Style x:Key="StatPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="12,5"/>
            </Style>

            <!-- Pilules de métadonnées (niveau, type) -->
            <Style x:Key="MetaPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,1"/>
            </Style>

            <!-- Conteneur de groupe discret -->
            <Style x:Key="HistoryGroupContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Style pour les éléments de l'historique -->
            <Style x:Key="HistoryItemContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête serein -->
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,16">
            <TextBlock Text="Mes documents" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock Text="Retrouvez toutes vos fiches, évaluations et quiz sauvegardés automatiquement sur cet ordinateur."
                       Style="{StaticResource CaptionSecondaryStyle}"/>
        </StackPanel>

        <!-- Barre de recherche -->
        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="1"
                        Margin="0,0,0,12"
                        PlaceholderText="Rechercher par titre, matière, niveau ou mot-clé…"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        QueryIcon="Find"
                        Visibility="{x:Bind local:HistoryPage.InverseBoolToVisibility(ViewModel.IsLoading), Mode=OneWay}"/>

        <!-- Filtres par type -->
        <RadioButtons x:Name="FilterRadioButtons"
                      Grid.Row="2"
                      Margin="0,0,0,16"
                      MaxColumns="5"
                      SelectedIndex="0"
                      SelectionChanged="OnFilterSelectionChanged"
                      Visibility="{x:Bind local:HistoryPage.InverseBoolToVisibility(ViewModel.IsLoading), Mode=OneWay}">
            <RadioButton Content="Tout" 
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Fiches"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Évaluations"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Quiz"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
            <RadioButton Content="Favoris"
                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
        </RadioButtons>

        <!-- Indicateur de chargement -->
        <ProgressRing Grid.Row="3"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- État vide -->
        <StackPanel Grid.Row="3"
                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ShowEmptyState), Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <FontIcon FontFamily="Segoe MDL2 Assets"
                      Glyph="&#xE74D;"
                      FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Margin="0,0,0,12"/>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextAlignment="Center"
                      MaxWidth="400"/>
        </StackPanel>

        <!-- Contenu principal - Liste des éléments -->
        <ScrollViewer Grid.Row="3"
                      Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}">
            <StackPanel>
                <!-- Statistiques -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource StatPillStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.StatsTotalDisplay}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource StatPillStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.StatsMonthDisplay}" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource StatPillStyle}">
                        <TextBlock Text="{x:Bind ViewModel.StatsFavoritesDisplay}" FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Liste groupée -->
                <ListView ItemsSource="{x:Bind ViewModel.GroupedItems}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemContainerStyle="{StaticResource HistoryGroupContainerStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryGroupViewModel">
                            <StackPanel>
                                <!-- En-tête de groupe -->
                                <TextBlock Text="{x:Bind Header}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                
                                <!-- Éléments du groupe -->
                                <ItemsControl ItemsSource="{x:Bind Items}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                            <Border Style="{StaticResource HistoryItemContainerStyle}" 
                                                    Margin="0,0,0,8"
                                                    Tapped="OnItemClicked"
                                                    KeyDown="OnItemKeyDown"
                                                    IsTabStop="True"
                                                    Tag="{Binding}"
                                                    AutomationProperties.Name="{x:Bind Title}"
                                                    AutomationProperties.HelpText="{x:Bind TypeDisplay}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Icône de type -->
                                                    <TextBlock Grid.Column="0" 
                                                               Grid.Row="0"
                                                               Text="{x:Bind TypeEmoji}"
                                                               FontSize="20"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Titre et métadonnées -->
                                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Style="{StaticResource MetaPillStyle}" Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind TypeDisplay}" FontSize="11"/>
                                                            </Border>
                                                            <Border Style="{StaticResource MetaPillStyle}" Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind LevelBadge}" FontSize="11"/>
                                                            </Border>
                                                            <TextBlock Text="{x:Bind CreatedTimeDisplay}"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Extrait de recherche -->
                                                    <TextBlock Grid.Column="1"
                                                               Grid.Row="1"
                                                               Text="{x:Bind Snippet}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind local:HistoryPage.BoolToVisibility(HasSnippet), Mode=OneWay}"
                                                               Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Boutons d'action (§8.2) -->
                                                    <StackPanel Grid.Column="2" 
                                                                Grid.Row="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{ThemeResource SubtleButtonStyle}"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Content="{x:Bind FavoriteGlyph, Mode=OneWay}"
                                                                ToolTipService.ToolTip="{x:Bind FavoriteText, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind FavoriteText, Mode=OneWay}"
                                                                Tag="{Binding}"
                                                                Click="OnFavoriteClicked"
                                                                Margin="0,0,4,0"/>
                                                        
                                                        <Button Style="{ThemeResource SubtleButtonStyle}"
                                                                ToolTipService.ToolTip="Options du document (⋯)"
                                                                AutomationProperties.Name="Options du document"
                                                                Tag="{Binding}">
                                                            <FontIcon Glyph="&#xE712;" FontSize="12"/>
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem Text="Ouvrir le document" Click="OnOpenMenuItemClicked" Tag="{Binding}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE8E5;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutItem Text="Exporter en Word (.docx)" Click="OnExportWordMenuItemClicked" Tag="{Binding}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE8A5;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutItem Text="Exporter en PDF" Click="OnExportPdfMenuItemClicked" Tag="{Binding}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xEA90;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutSeparator/>
                                                                    <MenuFlyoutItem Text="Supprimer le document" Click="OnDeleteClicked" Tag="{Binding}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE74D;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast d'annulation de suppression (§8.3) -->
        <Border x:Name="UndoToast" Grid.Row="0"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="16,10" CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="UndoToastText" Text="Document supprimé" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="UndoToastButton" Content="Annuler" Style="{ThemeResource AccentButtonStyle}"
                        Padding="12,4" FontSize="12" Click="OnUndoDeleteClicked"/>
                <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6" Click="OnDismissUndoClicked">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
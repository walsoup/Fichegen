<UserControl
    x:Class="FicheGen.App.Views.Controls.PreviewHost"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:FicheGen.App.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Converters -->
        <converters:StringFormatConverter x:Key="StringFormatConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Styles de boutons de la barre d'outils -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>

        <!-- Animation de shimmer du squelette -->
        <Storyboard x:Name="ShimmerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SkelTitle" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="SkelSub" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="SkelL1" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="SkelL2" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="SkelL3" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="SkelL4" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="SkelCard" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetName="SkelL5" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.7"/>
            <DoubleAnimation Storyboard.TargetName="SkelL6" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="SkelL7" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.2" AutoReverse="True" BeginTime="0:0:0.9"/>
        </Storyboard>

        <!-- Pulsation du point « Rendu en direct » -->
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseDot" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.7" AutoReverse="True"/>
        </Storyboard>

        <!-- Entrée en douceur de l'état vide -->
        <Storyboard x:Name="EmptyEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="EmptyStatePanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="EmptyStateTransform" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Barre d'outils permanente -->
            <RowDefinition Height="Auto"/>
            <!-- Bannières (export, streaming) -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Zone principale de document / état vide / erreur -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Barre d'outils permanente (AppCommandBar UX-03) ================= -->
        <Border x:Name="TopToolbarBorder"
                Grid.Row="0"
                Padding="12,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                x:Uid="PH_Toolbar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Groupe Style & Vue Élève/Corrigé -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Séparateur -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Groupe Zoom -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Espace flexible -->
                    <ColumnDefinition Width="*"/>
                    <!-- Groupe Exports & Actions -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Style & Élève/Corrigé -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8D2;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="StylePresetComboBox" x:Uid="PH_StyleCombo"
                              MinWidth="140"
                              SelectedIndex="0"
                              SelectionChanged="OnStylePresetSelectionChanged"
                              ToolTipService.ToolTip="Style visuel de la fiche"
                              AutomationProperties.Name="Style visuel du document">
                        <ComboBoxItem x:Uid="PH_StyleModern" Content="Moderne" Tag="modern"/>
                        <ComboBoxItem x:Uid="PH_StyleClassic" Content="Classique" Tag="classic"/>
                        <ComboBoxItem x:Uid="PH_StyleMinimal" Content="Minimaliste" Tag="minimal"/>
                        <ComboBoxItem x:Uid="PH_StyleAcademic" Content="Académique" Tag="academic"/>
                        <ComboBoxItem x:Uid="PH_StylePlayful" Content="Ludique" Tag="playful"/>
                    </ComboBox>

                    <Button x:Name="StudentViewButton"
                            x:Uid="PH_StudentButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnStudentViewClicked"
                            ToolTipService.ToolTip="Basculer entre la version enseignant (avec corrigé) et la version élève (Ctrl+Shift+V)" AutomationProperties.Name="Basculer la version élève ou corrigé">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE77B;" FontSize="13"/>
                            <TextBlock Text="Élève / Corrigé" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Séparateur -->
                <Border Grid.Column="1" Width="1" Height="20" Margin="10,0" VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- 2. Zoom -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnZoomOutClicked"
                            x:Uid="PH_ZoomOut">
                        <FontIcon Glyph="&#xE71F;" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="ZoomPercentText" Text="100 %" Width="48" FontSize="12"
                               TextAlignment="Center" VerticalAlignment="Center"
                               x:Uid="PH_ZoomLevel"/>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnZoomInClicked"
                            x:Uid="PH_ZoomIn">
                        <FontIcon Glyph="&#xE8A3;" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Click="OnZoomResetClicked"
                            x:Uid="PH_ZoomReset">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                    </Button>
                </StackPanel>

                <!-- 3. Exports, Impression, Modification, Autres actions -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="EditDocButton" x:Uid="PH_EditButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnEditDocumentClicked"
                            ToolTipService.ToolTip="Modifier le texte et la structure du document"
                            AutomationProperties.Name="Modifier le document">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="PH_EditLabel" Text="Modifier" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportWordButton" x:Uid="PH_ExportWord"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnExportWordClicked"
                            ToolTipService.ToolTip="Exporter en document Word modifiable (Ctrl+Shift+W)"
                            AutomationProperties.Name="Exporter en Word">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="PH_WordLabel" Text="Word" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportPdfButton" x:Uid="PH_ExportPdf"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnExportPdfClicked"
                            ToolTipService.ToolTip="Exporter en document PDF imprimable (Ctrl+Shift+E)"
                            AutomationProperties.Name="Exporter en PDF">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEA90;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="PH_PdfLabel" Text="PDF" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PrintButton" x:Uid="PH_PrintButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnPrintClicked"
                            ToolTipService.ToolTip="Imprimer le document (Ctrl+P)"
                            AutomationProperties.Name="Imprimer le document">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE749;" FontSize="13"/>
                            <TextBlock x:Uid="PH_PrintLabel" Text="Imprimer" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Menu Autres actions -->
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            x:Uid="PH_MoreActions">
                        <FontIcon Glyph="&#xE712;" FontSize="13"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Uid="PH_MenuEdit" Text="✏️ Modifier le document" Click="OnEditDocumentClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" FontSize="14"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="PH_MenuRtf" Text="📄 Exporter en RTF" Click="OnExportRtfClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" FontSize="14"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="PH_MenuCopyText" Text="📋 Copier le texte complet" Click="OnCopyClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" FontSize="14"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="PH_MenuFind" Text="🔎 Rechercher dans le document" Click="OnFindClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" FontSize="14"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="PH_MenuOpenFolder" Text="📂 Ouvrir le dossier d'exportation" Click="OnOpenExportFolderClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" FontSize="14"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="ReadAloudMenuItem" x:Uid="PH_MenuReadAloud" Text="🔊 Lire à voix haute" Click="OnReadAloudClicked">
                                    <MenuFlyoutItem.Icon><FontIcon x:Name="ReadAloudMenuIcon" Glyph="&#xE995;" FontSize="14"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bannière d'exportation réussie avec actions rapides -->
        <InfoBar x:Name="ExportSuccessInfoBar" x:Uid="PH_ExportBanner"
                 Grid.Row="1"
                 IsOpen="{Binding ShowExportSuccessBanner, Mode=TwoWay}"
                 Severity="Success"
                 Title="Document exporté avec succès"
                 Message="{Binding ExportSuccessMessage}"
                 IsClosable="True"
                 Margin="12,6"
                 AutomationProperties.LiveSetting="Polite">
            <InfoBar.ActionButton>
                <Button x:Uid="PH_OpenExportedFolder" Content="Ouvrir le dossier"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{Binding OpenLastExportedFolderCommand}"/>
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <Button x:Uid="PH_OpenExportedFile" Content="Ouvrir le fichier"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Margin="0,0,0,4"
                        Command="{Binding OpenLastExportedFileCommand}"/>
            </InfoBar.Content>
        </InfoBar>

        <!-- Bannière de rendu progressif (streaming) -->
        <Border x:Name="StreamingBanner"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                x:Uid="PH_StreamingBanner">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="StreamingProgressBar"
                             Grid.Row="0"
                             Minimum="0" Maximum="100" Height="3"
                             IsIndeterminate="True"
                             Value="{Binding StreamingProgress, ElementName=Root}"
                             VerticalAlignment="Top"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="12,7">
                    <Ellipse x:Name="PulseDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Name="StreamingStatusText"
                               Text="{Binding StatusText, ElementName=Root}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="StreamingPercentText"
                               Text="{Binding Path=StreamingProgress, ElementName=Root, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:0} %'}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Zone de contenu -->
        <Grid Grid.Row="3" x:Name="ContentHost">

            <!-- État vide avec illustration de marque + astuces -->
            <StackPanel x:Name="EmptyStatePanel"
                        Opacity="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        MaxWidth="460"
                        Margin="24"
                        x:Uid="PH_EmptyState">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="EmptyStateTransform"/>
                </StackPanel.RenderTransform>

                <Border Width="112" Height="112" CornerRadius="28" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0"/>
                            <GradientStop Color="{ThemeResource SystemAccentColorLight1}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        <TextBlock Text="✨" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"/>
                    </Grid>
                </Border>

                <TextBlock x:Uid="PH_EmptyTitle" Text="Générez votre première fiche"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Uid="PH_EmptyBody" Text="Décrivez votre besoin, ajustez les paramètres, puis cliquez sur « Générer ». L'aperçu interactif de votre fiche apparaîtra ici."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Style="{ThemeResource AccentButtonStyle}" CornerRadius="16" x:Uid="PH_PaletteButton"
                                    Click="OnPaletteClicked"
                                    AutomationProperties.Name="Explorer les commandes (Ctrl+K)"
                                    ToolTipService.ToolTip="Ouvre la palette de commandes">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="13"/>
                                    <TextBlock x:Uid="PH_PaletteLabel" Text="Que puis-je faire ?" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ctrl+K" FontSize="11" Opacity="0.72" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Uid="PH_HistoryButton" Click="OnOpenHistoryClicked"
                                    AutomationProperties.Name="Ouvrir mes documents">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81C;" FontSize="13"/>
                                    <TextBlock x:Uid="PH_HistoryLabel" Text="Mes documents" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Margin="0,10,0,0"
                                Padding="16"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="💡" FontSize="14"/>
                            <TextBlock x:Uid="PH_TipsTitle" Text="Astuces rapides" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BE;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,1,0,0"/>
                            <TextBlock x:Uid="PH_Tip1" Text="Précisez le niveau (ex. : CM2) et l'objectif pédagogique pour un résultat plus ciblé."
                                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,1,0,0"/>
                            <TextBlock x:Uid="PH_Tip2" Text="Après la génération, demandez des ajustements à l'assistant IA dans le panneau latéral."
                                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE765;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,1,0,0"/>
                            <TextBlock x:Uid="PH_Tip3" Text="Raccourcis : Ctrl+G génère • Ctrl+P imprime • Ctrl+Shift+E exporte en PDF."
                                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Squelette & Suivi multi-étapes pendant la génération -->
            <Grid x:Name="SkeletonOverlay"
                  Visibility="Collapsed"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  x:Uid="PH_Skeleton">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="16" Padding="32,24">
                        
                        <!-- ══════ Indicateur multi-étapes de génération ══════ -->
                        <Border Padding="16,14" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ProgressRing IsActive="True" Width="18" Height="18"/>
                                        <TextBlock Text="{Binding GenerationPhaseText}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 4 Jalons pédagogiques -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Étape 1 : Analyse -->
                                    <Border Grid.Column="0" Padding="8,6" CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="🔍" FontSize="11"/>
                                            <TextBlock Text="1. Analyse" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Étape 2 : Structure -->
                                    <Border Grid.Column="1" Padding="8,6" CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="📑" FontSize="11"/>
                                            <TextBlock Text="2. Structure" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Étape 3 : Rédaction -->
                                    <Border Grid.Column="2" Padding="8,6" CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="✍️" FontSize="11"/>
                                            <TextBlock Text="3. Rédaction" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Étape 4 : Rendu -->
                                    <Border Grid.Column="3" Padding="8,6" CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="🎨" FontSize="11"/>
                                            <TextBlock Text="4. Rendu" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════ Aperçu du texte en direct (Streaming) ══════ -->
                        <Border x:Name="StreamedPreviewCard"
                                Visibility="Collapsed"
                                Padding="16" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Rédaction en direct par l'IA" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding StreamedWordCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0} mots'}"
                                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding StreamedContent}"
                                               FontSize="12" FontFamily="Segoe UI Variable, Segoe UI"
                                               LineHeight="19" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Squelette shimmer -->
                        <StackPanel x:Name="SkelShimmerGroup" Spacing="10" Margin="8,0">
                            <Border x:Name="SkelTitle" Height="28" Width="340" HorizontalAlignment="Left" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Border x:Name="SkelSub" Height="14" Width="220" HorizontalAlignment="Left" CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Border x:Name="SkelL1" Height="12" CornerRadius="4" Margin="0,12,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Border x:Name="SkelL2" Height="12" CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Border x:Name="SkelL3" Height="12" CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Border x:Name="SkelCard" Height="80" CornerRadius="8" Margin="0,8,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Border x:Name="SkelL5" Height="12" CornerRadius="4" Margin="0,8,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Border x:Name="SkelL6" Height="12" CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Aperçu WebView2 -->
            <WebView2 x:Name="WebViewControl"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      PointerWheelChanged="OnPreviewWheelChanged"
                      x:Uid="PH_WebView"/>

            <!-- Barre de recherche dans le document (Ctrl+F) -->
            <Border x:Name="FindBarBorder"
                    Visibility="{Binding IsFindBarVisible, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,24,0"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="100">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="FindQueryTextBox"
                             Text="{Binding FindQuery, Mode=TwoWay}"
                             PlaceholderText="Rechercher dans la fiche…"
                             Width="200"
                             TextChanged="FindQueryTextBox_TextChanged"
                             KeyDown="FindQueryTextBox_KeyDown"/>
                    <TextBlock Text="{Binding FindStatusText}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Command="{Binding FindPreviousCommand}"
                            ToolTipService.ToolTip="Précédent (Maj+Entrée)">
                        <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Command="{Binding FindNextCommand}"
                            ToolTipService.ToolTip="Suivant (Entrée)">
                        <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Command="{Binding ToggleFindBarCommand}"
                            ToolTipService.ToolTip="Fermer la recherche (Échap)">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Bulle de notification pour la copie dans le presse-papiers -->
            <TeachingTip x:Name="CopiedTip"
                         Title="Presse-papiers"
                         Subtitle="✓ Le texte complet a été copié dans le presse-papiers."
                         PreferredPlacement="Bottom"
                         IsLightDismissEnabled="True"/>

            <!-- État d'erreur WebView2 absent (UX-04) -->
            <StackPanel x:Name="WebView2ErrorPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="480"
                        Margin="24"
                        x:Uid="PH_ErrorPanel">
                <Border Width="72" Height="72" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                </Border>

                <TextBlock x:Uid="PH_ErrorTitle" Text="L'aperçu ne peut pas s'afficher"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Uid="PH_ErrorBody" Text="PROFstudio a besoin du composant Microsoft Edge WebView2 pour afficher et exporter vos documents. Il n'est pas installé sur cet ordinateur."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Uid="PH_InstallButton" Content="Installer le composant ↗"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnInstallWebView2Clicked"
                            AutomationProperties.Name="Installer le composant WebView2"/>
                    <Button x:Uid="PH_CopyLinkButton" Content="Copier le lien pour l'informaticien"
                            Click="OnCopyWebView2LinkClicked"
                            AutomationProperties.Name="Copier le lien de téléchargement pour l'administrateur"/>
                </StackPanel>

                <TextBlock x:Name="WebView2LinkCopiedNotice"
                           x:Uid="PH_LinkCopied" Text="✓ Lien copié dans le presse-papiers"
                           FontSize="12"
                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
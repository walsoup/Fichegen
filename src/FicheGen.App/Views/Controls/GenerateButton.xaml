<UserControl
    x:Class="FicheGen.App.Views.Controls.GenerateButton"
    x:Name="RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:FicheGen.App.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" IsInverted="False"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" IsInverted="True"/>
    </UserControl.Resources>

    <Grid>
        <!-- Idle State Button -->
        <Button x:Name="MainButton"
                Content="{Binding ButtonText, ElementName=RootControl}"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Click="OnMainButtonClicked"
                AutomationProperties.Name="{Binding ButtonText, ElementName=RootControl}"
                AutomationProperties.HelpText="Déclenche la génération du document (Raccourci: Ctrl+G)"
                Visibility="{Binding IsGenerating, ElementName=RootControl, Converter={StaticResource InverseBoolToVisConverter}}"/>

        <!-- Busy / Cancel State Button -->
        <Button x:Name="CancelButton"
                Style="{ThemeResource DefaultButtonStyle}"
                HorizontalAlignment="Stretch"
                Click="OnCancelButtonClicked"
                AutomationProperties.Name="Annuler la génération"
                AutomationProperties.HelpText="Annule la génération en cours (Raccourci: Échap)"
                Visibility="{Binding IsGenerating, ElementName=RootControl, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="True" Width="16" Height="16"/>
                <TextBlock Text="Annuler la génération (Échap)"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>

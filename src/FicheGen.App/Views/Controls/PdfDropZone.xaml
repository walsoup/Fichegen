<UserControl
    x:Class="FicheGen.App.Views.Controls.PdfDropZone"
    x:Name="RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="DropBorder"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12"
            AllowDrop="True"
            DragOver="OnDragOver"
            DragLeave="OnDragLeave"
            Drop="OnDrop"
            AutomationProperties.Name="Zone de sélection du guide pédagogique PDF"
            AutomationProperties.HelpText="Glissez-déposez un guide PDF ou cliquez pour en sélectionner un">

        <Grid>
            <!-- État 1 : Vide / Prêt au dépôt -->
            <StackPanel x:Name="EmptyStatePanel"
                        Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8E5;" FontSize="18"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Glisser un guide PDF ou cliquer pour parcourir"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Manuel scolaire, progression de cycle, etc. (optionnel)"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- État 2 : DragOver (survol actif) -->
            <StackPanel x:Name="DragOverPanel" Visibility="Collapsed"
                        Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE898;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Déposez le fichier PDF ici" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- État 3 : Fichier valide chargé -->
            <Grid x:Name="LoadedStatePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <FontIcon Glyph="&#xEA90;" FontSize="18"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="FileNameText" Text="guide.pdf"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="FileMetaText" Text="Guide PDF prêt pour l'ancrage pédagogique"
                               FontSize="11"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{ThemeResource SubtleButtonStyle}"
                        Padding="6" MinHeight="0" MinWidth="0"
                        Click="OnClearFileClicked"
                        ToolTipService.ToolTip="Retirer ce guide"
                        AutomationProperties.Name="Retirer le fichier PDF">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Button>
            </Grid>

            <!-- État 4 : Erreur (format non supporté, fichier verrouillé) -->
            <Grid x:Name="ErrorStatePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <FontIcon Glyph="&#xE783;" FontSize="18"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="ErrorTitleText" Text="Format non supporté"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock x:Name="ErrorMessageText" Text="Seuls les fichiers .pdf sont acceptés."
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{ThemeResource SubtleButtonStyle}"
                        Padding="6" MinHeight="0" MinWidth="0"
                        Click="OnClearFileClicked"
                        ToolTipService.ToolTip="Fermer"
                        AutomationProperties.Name="Fermer l'erreur">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>

            <!-- État 5 : Chargement en cours -->
            <StackPanel x:Name="ProcessingPanel" Visibility="Collapsed"
                        Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="18" Height="18"/>
                <TextBlock Text="Analyse du guide PDF en cours…" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

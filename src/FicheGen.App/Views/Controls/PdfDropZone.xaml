<UserControl
    x:Class="FicheGen.App.Views.Controls.PdfDropZone"
    x:Name="RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="DropBorder"
            BorderBrush="{ThemeResource SystemControlHighlightListAccentLowBrush}"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="16"
            AllowDrop="True"
            DragOver="OnDragOver"
            DragLeave="OnDragLeave"
            Drop="OnDrop"
            AutomationProperties.Name="Zone de dépôt de document PDF"
            AutomationProperties.HelpText="Glissez-déposez un fichier PDF de guide pédagogique ici">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE8B9;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="StatusTextBlock"
                       Text="{Binding DisplayText, ElementName=RootControl}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>

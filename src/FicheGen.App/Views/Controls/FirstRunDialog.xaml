<ContentDialog x:Uid="FRD_Dialog"
    x:Class="FicheGen.App.Views.Controls.FirstRunDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bienvenue dans PROFstudio"
    PrimaryButtonText="Commencer"
    CloseButtonText="Passer pour l'instant"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick">

    <Grid MaxWidth="560" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ Fil d'avancement ══════════ -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,14">
            <TextBlock x:Name="StepIndicatorText" x:Uid="FRD_StepIndicator" Text="Étape 1 sur 3"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <ProgressBar x:Name="StepProgress" Maximum="3" Value="1" Height="4"/>
        </StackPanel>

        <!-- ══════════ Étape 1 · Bienvenue ══════════ -->
        <StackPanel x:Name="Step1Panel" Grid.Row="1" Spacing="14" Visibility="Visible">

            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="{ThemeResource PROFstudioLogoBrush}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="26"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Uid="FRD_HeroTitle" Text="Votre assistant de préparation"
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Uid="FRD_HeroSubtitle" Text="Moins de temps derrière le bureau, plus devant vos élèves."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Uid="FRD_Intro" Text="PROFstudio prépare avec vous — et jamais à votre place — les documents du quotidien. Vous relisez, vous ajustez, vous validez : le document final vous ressemble."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="12" CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Uid="FRD_CardFicheTitle" Text="Fiche de séance" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Uid="FRD_CardFicheDesc" Text="Structurée, prête à imprimer ou à exporter." FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="12" CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Uid="FRD_CardEvalTitle" Text="Évaluation" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Uid="FRD_CardEvalDesc" Text="Exercices progressifs avec barème." FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="12" CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE9D5;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Uid="FRD_CardQuizTitle" Text="Quiz" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Uid="FRD_CardQuizDesc" Text="QCM imprimables avec corrigé." FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="12" CornerRadius="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE72E;" FontSize="15"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="FRD_LocalNote" Text="Rassurez-vous : vos documents restent sur votre ordinateur et aucun compte n'est à créer."
                               FontSize="12" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══════════ Étape 2 · Documents & guides (facultatif) ══════════ -->
        <StackPanel x:Name="Step2Panel" Grid.Row="1" Spacing="12" Visibility="Collapsed">

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Uid="FRD_GuidesHeader" Text="Vos documents de référence"
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <Border Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Uid="FRD_OptionalBadge" Text="Facultatif" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <TextBlock x:Uid="FRD_GuidesIntro" Text="Vous préparez souvent à partir d'un manuel ou d'une progression au format PDF ? Indiquez ici ce dossier : PROFstudio s'en servira pour caler les documents générés sur votre séquence."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <Border x:Name="DropZoneBorder" Padding="20" CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B9;" FontSize="30"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock x:Uid="FRD_DropHint" Text="Glissez-déposez un dossier ici"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="FRD_Or" Text="ou" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <Button x:Uid="FRD_PickFolder" Content="Choisir un dossier…"
                            Click="BrowseFolder_Click"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Choisir un dossier de documents"/>
                </StackPanel>
            </Border>

            <TextBox x:Name="GuidesFolderTextBox" IsReadOnly="True"
                     Header="Dossier sélectionné"
                     x:Uid="FRD_FolderBox" PlaceholderText="Aucun dossier — vous pourrez en choisir un plus tard"/>

            <TextBlock x:Uid="FRD_FolderHint" Text="Aucune idée du dossier à indiquer ? Passez simplement à l'étape suivante : tout reste modifiable dans Paramètres ▸ Dossiers."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ══════════ Étape 3 · Assistant IA ══════════ -->
        <StackPanel x:Name="Step3Panel" Grid.Row="1" Spacing="12" Visibility="Collapsed">

            <StackPanel Spacing="2">
                <TextBlock x:Uid="FRD_ProviderHeader" Text="Choisissez votre assistant IA"
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Uid="FRD_ProviderSub" Text="C'est lui qui rédige le premier jet. Vous gardez toujours le contrôle final."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <RadioButtons x:Name="ProviderRadioButtons" SelectedIndex="0"
                          SelectionChanged="ProviderRadioButtons_SelectionChanged"
                          AutomationProperties.Name="Assistant IA utilisé pour la rédaction">

                <RadioButton x:Uid="FRD_ProviderGoogle">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="FRD_GoogleName" Text="Google AI Studio" FontWeight="SemiBold"/>
                                <Border Padding="7,1" CornerRadius="9"
                                        Background="{ThemeResource StatusPositiveBgBrush}">
                                    <TextBlock x:Uid="FRD_GoogleBadge" Text="Gratuit · Recommandé" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{ThemeResource StatusPositiveFgBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Uid="FRD_GoogleDesc" Text="Le plus simple pour débuter : il suffit d'une adresse Google."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Uid="FRD_ProviderOpenAi">
                    <StackPanel Spacing="1">
                        <TextBlock x:Uid="FRD_OpenAiName" Text="OpenAI (ChatGPT)" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="FRD_OpenAiDesc" Text="Pour celles et ceux qui ont déjà une clé OpenAI."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Uid="FRD_ProviderLocal">
                    <StackPanel Spacing="1">
                        <TextBlock x:Uid="FRD_LocalName" Text="Serveur local — avancé" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="FRD_LocalDesc" Text="100 % hors ligne, rien ne quitte l'école. Nécessite Ollama installé par votre référent informatique."
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </RadioButtons>

            <!-- Clé d'API, expliquée sans jargon -->
            <StackPanel x:Name="ApiKeySection" Spacing="8">
                <Border Padding="12" CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D7;" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Uid="FRD_KeyQuestion" Text="Et la fameuse « clé d'accès » ?"
                                       FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <TextBlock x:Uid="FRD_KeyExplain" Text="C'est simplement le code personnel qui relie PROFstudio au service choisi — un peu comme un mot de passe. Vous la collez une seule fois ci-dessous : elle est rangée dans le coffre sécurisé de Windows et ne quitte jamais cet ordinateur."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <PasswordBox x:Name="ApiKeyPasswordBox"
                             x:Uid="FRD_KeyBox" PlaceholderText="Collez votre clé ici (Ctrl+V)"
                             PasswordRevealMode="Peek"
                             AutomationProperties.Name="Clé d'accès du service IA"/>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <HyperlinkButton x:Name="GetKeyHyperlink" Padding="0"
                                     x:Uid="FRD_GetKeyLink" Content="Où trouver ma clé gratuite ? ↗"
                                     NavigateUri="https://aistudio.google.com/app/apikey"
                                     AutomationProperties.Name="Ouvrir la page qui fournit la clé"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="KeyOptionalNote" Text="Pressé·e ? Terminez sans clé : PROFstudio vous rappellera comment l'ajouter au bon moment."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</ContentDialog>

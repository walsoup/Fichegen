<UserControl
    x:Class="FicheGen.App.Views.Controls.GenerateCta"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Bouton d'action principal : pilule accent au repos, état « Arrêter » pendant la génération. -->
    <Button x:Name="ActionButton"
            MinHeight="40"
            Padding="0"
            CornerRadius="20"
            Style="{ThemeResource AccentButtonStyle}"
            HorizontalAlignment="Stretch"
            Click="OnButtonClick">
        <Grid>
            <!-- Repos : Générer -->
            <StackPanel x:Name="IdlePanel" Orientation="Horizontal" Spacing="9"
                        HorizontalAlignment="Center" Padding="18,9">
                <FontIcon Glyph="&#xE99A;" FontSize="15"/>
                <TextBlock x:Uid="CTA_IdleLabel" Text="Générer avec l’IA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Uid="CTA_ShortcutIdle" Text="Ctrl+G" FontSize="11" FontWeight="SemiBold" Opacity="0.72"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Occupé : Arrêter -->
            <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Spacing="9"
                        HorizontalAlignment="Center" Padding="18,9" Visibility="Collapsed">
                <ProgressRing Width="16" Height="16" IsActive="True"/>
                <TextBlock x:Uid="CTA_BusyLabel" Text="Arrêter la génération" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Uid="CTA_ShortcutBusy" Text="Échap" FontSize="11" FontWeight="SemiBold" Opacity="0.72"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>

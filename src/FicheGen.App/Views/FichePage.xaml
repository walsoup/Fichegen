<Page
    x:Class="FicheGen.App.Views.FichePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="900">

    <Page.Resources>
        <DataTemplate x:Key="SubjectItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- AppCommandBar (§6.2) -->
            <RowDefinition Height="*"/>    <!-- Contenu Workspace -->
        </Grid.RowDefinitions>

        <!-- ═══════════ Ligne 0 : Barre de commandes unifiée (§6.2) ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titre de la page -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                <TextBlock x:Uid="FP_Title" Text="Nouvelle fiche pédagogique" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock x:Uid="FP_Subtitle" Text="Préparez une séance structurée, prête à imprimer ou exporter."
                           Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>

            <!-- Les commandes du document (zoom, exports, impression, élève/corrigé)
                 vivent désormais uniquement dans la barre d'outils de l'aperçu (PreviewHost). -->

            <!-- Bouton Assistant à droite -->
            <Button Grid.Column="2" x:Name="AssistantToggleButton" Margin="8,0,0,0"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Click="OnToggleAssistantClicked"
                    VerticalAlignment="Center"
                    x:Uid="FP_AssistantToggle">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="✨" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="FP_AssistantLabel" Text="Assistant" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════ Ligne 1 : Workspace 3 colonnes partagé ═══════════ -->
        <controls:CreationWorkspace Grid.Row="1" x:Name="Workspace"
                                    FormWidthSettingsKey="FicheGen.FichePage.FormColumnWidth"
                                    GenerateRequested="GenerateCta_GenerateRequested"
                                    CancelRequested="GenerateCta_CancelRequested">

            <!-- ═══════════ Cartes du formulaire propres à la Fiche ═══════════ -->
            <StackPanel Spacing="12">

                <!-- Étape 1 : Classe et Matière -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="FP_Step1_Header" Text="1. Classe et Matière" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LevelCombo" x:Uid="FP_LevelCombo" Header="Niveau" HorizontalAlignment="Stretch"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding ClassLevel, Mode=TwoWay}"
                                      SelectionChanged="LevelCombo_SelectionChanged"
                                      AutomationProperties.Name="Niveau scolaire">
                                <ComboBoxItem Content="CP"/>
                                <ComboBoxItem Content="CE1"/>
                                <ComboBoxItem Content="CE2"/>
                                <ComboBoxItem Content="CM1"/>
                                <ComboBoxItem Content="CM2"/>
                                <ComboBoxItem Content="6e"/>
                                <ComboBoxItem Content="5e"/>
                                <ComboBoxItem Content="4e"/>
                                <ComboBoxItem Content="3e"/>
                            </ComboBox>
                            <ComboBox x:Name="SubjectCombo" Grid.Column="1" x:Uid="FP_SubjectCombo" Header="Matière" HorizontalAlignment="Stretch"
                                      IsEditable="True"
                                      PlaceholderText="Sélectionner ou saisir"
                                      ItemTemplate="{StaticResource SubjectItemTemplate}"
                                      Text="{Binding Subject, Mode=TwoWay}"
                                      SelectionChanged="SubjectCombo_SelectionChanged"
                                      TextSubmitted="SubjectCombo_TextSubmitted"
                                      AutomationProperties.Name="Matière"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Étape 2 : Sujet de la séance -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="FP_Step2_Header" Text="2. Sujet de la séance" Style="{StaticResource CardHeaderStyle}"/>
                        <AutoSuggestBox x:Name="TopicBox" x:Uid="FP_TopicBox"
                                        PlaceholderText="ex : Les fractions décimales, La Révolution française…"
                                        Text="{Binding Topic, Mode=TwoWay}"
                                        TextChanged="TopicBox_TextChanged"
                                        SuggestionChosen="TopicBox_SuggestionChosen"
                                        QuerySubmitted="TopicBox_QuerySubmitted"
                                        AutomationProperties.Name="Sujet de la leçon"/>
                    </StackPanel>
                </Border>

                <!-- Étape 3 : Durée & Consignes -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="FP_Step3_Header" Text="3. Cadre &amp; Durée" Style="{StaticResource CardHeaderStyle}"/>
                        <NumberBox x:Name="DurationBox" x:Uid="FP_DurationBox" Header="Durée de la séance (minutes)"
                                   Minimum="15" Maximum="180" SmallChange="5" LargeChange="15"
                                   Value="{Binding DurationMinutes, Mode=TwoWay}"
                                   ValueChanged="DurationBox_ValueChanged"
                                   AutomationProperties.Name="Durée en minutes"/>
                        <!-- Puces de sélection rapide de durée (§6.3) -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="30 min" Click="OnDurationQuickPickClicked" Tag="30" AutomationProperties.Name="30 minutes"/>
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="45 min" Click="OnDurationQuickPickClicked" Tag="45" AutomationProperties.Name="45 minutes"/>
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="55 min" Click="OnDurationQuickPickClicked" Tag="55" AutomationProperties.Name="55 minutes"/>
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="60 min" Click="OnDurationQuickPickClicked" Tag="60" AutomationProperties.Name="60 minutes"/>
                        </StackPanel>
                        <TextBox x:Name="InstructionsBox" x:Uid="FP_InstructionsBox" Header="Consignes additionnelles (optionnel)"
                                 PlaceholderText="Précisez un contexte, des besoins DYS, un travail en groupe…"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="68"
                                 Text="{Binding AdditionalInstructions, Mode=TwoWay}"
                                 TextChanged="InstructionsBox_TextChanged"
                                 AutomationProperties.Name="Consignes additionnelles"/>
                    </StackPanel>
                </Border>

                <!-- Étape 4 : Manuel PDF optionnel -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="FP_Step4_Header" Text="4. Appui documentaire PDF (optionnel)" Style="{StaticResource CardHeaderStyle}"/>
                        <controls:PdfDropZone x:Name="PdfDropZoneControl"
                                              GuideFilePath="{Binding GuideFilePath, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:CreationWorkspace>
    </Grid>
</Page>

<Page
    x:Class="FicheGen.App.Views.FichePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FicheGen.App.Views.Controls"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="900">

    <Page.Resources>
        <DataTemplate x:Key="SubjectItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- AppCommandBar (§6.2) -->
            <RowDefinition Height="*"/>    <!-- Contenu Workspace -->
        </Grid.RowDefinitions>

        <!-- ═══════════ Ligne 0 : Barre de commandes unifiée (§6.2) ═══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <!-- Titre de la page -->
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="PageTitle" x:Uid="FP_Title" Text="Nouvelle fiche pédagogique" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="PageSubtitle" x:Uid="FP_Subtitle" Text="Préparez une séance structurée, prête à imprimer ou exporter."
                           Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Ligne 1 : Workspace 3 colonnes partagé ═══════════ -->
        <controls:CreationWorkspace Grid.Row="1" x:Name="Workspace"
                                    FormWidthSettingsKey="FicheGen.FichePage.FormColumnWidth"
                                    GenerateRequested="GenerateCta_GenerateRequested"
                                    CancelRequested="GenerateCta_CancelRequested">

            <!-- ═══════════ Cartes du formulaire propres à la Fiche ═══════════ -->
            <StackPanel Spacing="12">

                <!-- Étape 1 : Classe et Matière -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="Step1Header" x:Uid="FP_Step1_Header" Text="1. Classe et Matière" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LevelCombo" x:Uid="FP_LevelCombo" Header="Niveau" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ClassLevels}"
                                      SelectedItem="{Binding ClassLevel, Mode=TwoWay}"
                                      SelectionChanged="LevelCombo_SelectionChanged"
                                      AutomationProperties.Name="Niveau scolaire"/>
                            <ComboBox x:Name="SubjectCombo" Grid.Column="1" x:Uid="FP_SubjectCombo" Header="Matière" HorizontalAlignment="Stretch"
                                      IsEditable="True"
                                      PlaceholderText="Sélectionner ou saisir"
                                      ItemTemplate="{StaticResource SubjectItemTemplate}"
                                      Text="{Binding Subject, Mode=TwoWay}"
                                      SelectionChanged="SubjectCombo_SelectionChanged"
                                      TextSubmitted="SubjectCombo_TextSubmitted"
                                      AutomationProperties.Name="Matière"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Étape 2 : Sujet de la séance -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Step2Header" x:Uid="FP_Step2_Header" Text="2. Sujet de la séance" Style="{StaticResource CardHeaderStyle}"/>
                        <AutoSuggestBox x:Name="TopicBox" x:Uid="FP_TopicBox"
                                        PlaceholderText="ex : Les fractions décimales, La Révolution française…"
                                        Text="{Binding Topic, Mode=TwoWay}"
                                        TextChanged="TopicBox_TextChanged"
                                        SuggestionChosen="TopicBox_SuggestionChosen"
                                        QuerySubmitted="TopicBox_QuerySubmitted"
                                        AutomationProperties.Name="Sujet de la leçon"/>
                    </StackPanel>
                </Border>

                <!-- Étape 3 : Durée & Consignes -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="Step3Header" x:Uid="FP_Step3_Header" Text="3. Cadre &amp; Durée" Style="{StaticResource CardHeaderStyle}"/>
                        <NumberBox x:Name="DurationBox" x:Uid="FP_DurationBox" Header="Durée de la séance (minutes)"
                                   Minimum="15" Maximum="180" SmallChange="5" LargeChange="15"
                                   Value="{Binding DurationMinutes, Mode=TwoWay}"
                                   ValueChanged="DurationBox_ValueChanged"
                                   AutomationProperties.Name="Durée en minutes"/>
                        <!-- Puces de sélection rapide de durée (§6.3) -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="30 min" Click="OnDurationQuickPickClicked" Tag="30" AutomationProperties.Name="30 minutes"/>
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="45 min" Click="OnDurationQuickPickClicked" Tag="45" AutomationProperties.Name="45 minutes"/>
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="55 min" Click="OnDurationQuickPickClicked" Tag="55" AutomationProperties.Name="55 minutes"/>
                            <Button Style="{StaticResource ChoiceChipStyle}" Content="60 min" Click="OnDurationQuickPickClicked" Tag="60" AutomationProperties.Name="60 minutes"/>
                        </StackPanel>
                        <TextBox x:Name="InstructionsBox" x:Uid="FP_InstructionsBox" Header="Consignes additionnelles (optionnel)"
                                 PlaceholderText="Précisez un contexte, des besoins DYS, un travail en groupe…"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="68"
                                 Text="{Binding AdditionalInstructions, Mode=TwoWay}"
                                 TextChanged="InstructionsBox_TextChanged"
                                 AutomationProperties.Name="Consignes additionnelles"/>

                        <!-- Longueur du document (Slider n6) -->
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Longueur / Densité du document" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding DocumentLengthLabel}" FontSize="12"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1"
                                    SnapsTo="StepValues"
                                    Value="{Binding DocumentLengthIndex, Mode=TwoWay}"
                                    AutomationProperties.Name="Longueur du document"/>
                            <Grid Margin="2,-4,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bref" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Raccourci" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Défaut" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Long" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Détaillé" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Exhaustif" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Étape 4 : Manuel PDF optionnel -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Step4Header" x:Uid="FP_Step4_Header" Text="4. Appui documentaire PDF (optionnel)" Style="{StaticResource CardHeaderStyle}"/>
                        <controls:PdfDropZone x:Name="PdfDropZoneControl"
                                              GuideFilePath="{Binding GuideFilePath, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:CreationWorkspace>
    </Grid>
</Page>

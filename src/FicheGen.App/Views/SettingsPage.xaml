<Page
    x:Class="FicheGen.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:FicheGen.App.ViewModels"
    xmlns:converters="using:FicheGen.App.Converters"
    xmlns:local="using:FicheGen.App.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- ═══════ Convertisseurs ═══════ -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" IsInverted="False"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" IsInverted="True"/>

        <!-- ═══════ Styles réutilisables ═══════ -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="CaptionNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ExpanderInnerPanelStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="14"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <!-- Pilule de statut générique -->
        <Style x:Key="PillBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Manquant en 1.4.1 — utilisé dans la galerie de thèmes Styles -->
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>
    </Page.Resources>

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Raccourci global Ctrl+S -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- EN-TÊTE DE PAGE                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="24,20,24,4" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="PageTitle" x:Uid="SP_Title" Text="Paramètres" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="PageSubtitle" x:Uid="SP_Subtitle" Text="Configurez PROFstudio : apparence, intelligence artificielle, styles de documents et confidentialité."
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <TextBlock Text="v1.4" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- BARRE D'ONGLETS (SelectorBar Fluent 2)                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <SelectorBar x:Name="SettingsTabs" Grid.Row="1" Margin="24,10,24,0"
                     SelectionChanged="SettingsTabs_SelectionChanged"
                     AutomationProperties.Name="Sections des paramètres">
            <SelectorBarItem x:Name="TabGeneral" x:Uid="SP_TabGeneral" Text="Général">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE771;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabAi" x:Uid="SP_TabAi" Text="IA &amp; Routage">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE99A;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabFolders" x:Uid="SP_TabFolders" Text="Dossiers">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabStyles" x:Uid="SP_TabStyles" Text="Styles">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE790;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabPrivacy" x:Uid="SP_TabPrivacy" Text="Confidentialité">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE72E;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabPrompts" x:Uid="SP_TabPrompts" Text="Prompts &amp; Raccourcis">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE70F;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ZONE DE CONTENU                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" Padding="24,14,24,20">
            <Grid MaxWidth="1020" HorizontalAlignment="Left">

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 1 · GÉNÉRAL &amp; APPARENCE               -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelGeneral" Spacing="12" Visibility="Visible">

                    <TextBlock x:Name="AccountHeader" x:Uid="SP_AccountHeader" Text="Compte &amp; Accès Enseignant" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Carte Compte Déconnecté -->
                    <controls:SettingsCard x:Name="AccountCard" x:Uid="SP_AccountCard" Header="Mon compte enseignant PROFstudio"
                                           Description="Connectez-vous avec votre compte enseignant pour activer les modèles IA Cloud et synchroniser vos fiches."
                                           Visibility="{x:Bind ViewModel.IsAccountConnected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></controls:SettingsCard.HeaderIcon>
                        <Button x:Name="AccountConnectBtn" x:Uid="SP_AccountConnectBtn" Content="Connexion / Créer un compte…" Click="OpenAccountDialog_Click"
                                Style="{ThemeResource AccentButtonStyle}"/>
                    </controls:SettingsCard>

                    <!-- Carte Compte Connecté -->
                    <controls:SettingsCard Header="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}"
                                           Description="{x:Bind ViewModel.AccountDescription, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsAccountConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Badge statut -->
                            <Border Background="#1A107C10" BorderBrush="#33107C10" BorderThickness="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#107C10"/>
                                    <TextBlock Text="{x:Bind ViewModel.AccountStatusBadge, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#107C10"/>
                                </StackPanel>
                            </Border>

                            <!-- Quota badge -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE945;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.AccountQuotaText, Mode=OneWay}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="AccountProfileBtn" x:Uid="SP_AccountProfileBtn" Content="Mon profil &amp; Quota…" Click="OpenAccountDialog_Click" Style="{ThemeResource AccentButtonStyle}"/>
                            <Button ToolTipService.ToolTip="Se déconnecter" Command="{x:Bind ViewModel.SignOutAccountCommand}" Background="Transparent" BorderBrush="Transparent" Padding="8,6" AutomationProperties.Name="Se déconnecter">
                                <FontIcon Glyph="&#xE8AC;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>

                    <TextBlock x:Name="ProfileHeader" x:Uid="SP_ProfileHeader" Text="Profil de l'enseignant·e" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Name="TeacherNameCard" x:Uid="SP_TeacherName" Header="Nom / Identité" Description="Affiché dans l'en-tête de l'application et sur vos fiches.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;"/></controls:SettingsCard.HeaderIcon>
                        <TextBox x:Name="TeacherNameBox" x:Uid="SP_TeacherNameBox" MinWidth="260" Text="{x:Bind ViewModel.TeacherName, Mode=TwoWay}" PlaceholderText="ex. M. Dupont / Mme Martin"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="SchoolNameCard" x:Uid="SP_SchoolName" Header="École / Établissement" Description="Nom de l'établissement imprimé sur les documents générés.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE80F;"/></controls:SettingsCard.HeaderIcon>
                        <TextBox x:Name="SchoolNameBox" x:Uid="SP_SchoolNameBox" MinWidth="260" Text="{x:Bind ViewModel.SchoolName, Mode=TwoWay}" PlaceholderText="ex. École Louise-Michel"/>
                    </controls:SettingsCard>

                    <TextBlock x:Name="UiHeader" x:Uid="SP_UiHeader" Text="Personnalisation de l'interface" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Name="AppThemeCard" x:Uid="SP_AppTheme" Header="Thème de l'application"
                                           Description="Appliqué immédiatement à toute l'interface PROFstudio.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="260"
                                  AutomationProperties.Name="Thème de l'application"
                                  ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ThemeOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="AccentColorCard" x:Uid="SP_AccentColor" Header="Couleur d'accentuation"
                                           Description="Teinte de marque PROFstudio — appliquée immédiatement à toute l'interface.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="260"
                                  AutomationProperties.Name="Couleur d'accentuation"
                                  ItemsSource="{x:Bind ViewModel.AccentOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:AccentOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse Width="16" Height="16" Fill="{x:Bind Brush}"/>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="LanguageCard" x:Uid="SP_Language" Header="Langue de l'interface"
                                           Description="Sélectionnez la langue de l'application (Français, English, العربية).">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="260"
                                  AutomationProperties.Name="Langue de l'interface"
                                  ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedLanguageOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:LanguageOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <TextBlock x:Name="PedagogicalHeader" x:Uid="SP_PedagogicalHeader" Text="Préférences pédagogiques" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Name="DefaultLevelCard" x:Uid="SP_DefaultLevel" Header="Niveau scolaire par défaut"
                                           Description="Présélectionné automatiquement à chaque nouvelle fiche.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BE;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="180" SelectedItem="{x:Bind ViewModel.DefaultClassLevel, Mode=TwoWay}">
                            <x:String>CP</x:String><x:String>CE1</x:String><x:String>CE2</x:String>
                            <x:String>CM1</x:String><x:String>CM2</x:String>
                            <x:String>6e</x:String><x:String>5e</x:String><x:String>4e</x:String><x:String>3e</x:String>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="DefaultSubjectCard" x:Uid="SP_DefaultSubject" Header="Matière par défaut"
                                           Description="Champ libre — choisissez dans la liste ou saisissez votre matière.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE70F;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="240" IsEditable="True" Text="{x:Bind ViewModel.DefaultSubject, Mode=TwoWay}">
                            <x:String>Mathématiques</x:String>
                            <x:String>Français</x:String>
                            <x:String>Histoire-Géographie</x:String>
                            <x:String>Sciences et technologie</x:String>
                            <x:String>Langues vivantes</x:String>
                            <x:String>Arts plastiques</x:String>
                            <x:String>Éducation musicale</x:String>
                            <x:String>EPS</x:String>
                        </ComboBox>
                    </controls:SettingsCard>

                    <TextBlock x:Name="StartupHeader" x:Uid="SP_StartupHeader" Text="Démarrage de Windows" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Name="LaunchAtStartupCard" x:Uid="SP_LaunchAtStartup" Header="Lancer PROFstudio au démarrage de Windows"
                                           Description="{x:Bind ViewModel.StartupStatusText, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled"
                                      OnContent="Activé" OffContent="Désactivé"
                                      AutomationProperties.Name="Lancer PROFstudio au démarrage"/>
                    </controls:SettingsCard>

                    <TextBlock x:Name="AboutHeader" x:Uid="SP_AboutHeader" Text="À propos de l'application" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Name="AboutCard" x:Uid="SP_AboutCard" Header="À propos de PROFstudio"
                                           Description="Version 1.4 — Conçu pour les enseignants. Génération pédagogique locale et sécurisée.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;"/></controls:SettingsCard.HeaderIcon>
                        <Button x:Name="AboutBtn" x:Uid="SP_AboutBtn" Content="Afficher les informations…" Command="{x:Bind ViewModel.ShowAboutCommand}"
                                ToolTipService.ToolTip="Informations sur l'application et mentions légales"/>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 2 · FOURNISSEURS IA &amp; ROUTAGE         -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelAi" Spacing="12" Visibility="Collapsed">

                    <!-- Mode de configuration IA -->
                    <controls:SettingsCard x:Uid="SP_AiConfigMode" Header="Mode de configuration IA"
                                           Description="Basculer entre le mode zéro-configuration inclus et la gestion avancée des modèles et clés.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE71D;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableExpertMode, Mode=TwoWay}"
                                      OnContent="Mode Expert (Avancé)" OffContent="Mode Clé en main (Recommandé)"/>
                    </controls:SettingsCard>

                    <!-- Affichage du texte en direct (Streaming) -->
                    <controls:SettingsCard x:Name="StreamingCard" x:Uid="SP_Streaming" Header="Affichage du texte en direct (Streaming)"
                                           Description="Affiche le document au fur et à mesure de sa rédaction par l'IA.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE99A;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableStreaming, Mode=TwoWay}"
                                      OnContent="Activé" OffContent="Désactivé"
                                      AutomationProperties.Name="Affichage du texte en direct"/>
                    </controls:SettingsCard>

                    <!-- ───── Vue Standard (Zéro configuration) ───── -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.EnableExpertMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <!-- Déconnecté -->
                        <controls:SettingsCard x:Uid="SP_CloudService" Header="Service Cloud PROFstudio"
                                               Description="Génération pédagogique haute performance incluse. Connectez-vous avec votre compte enseignant pour activer le cloud."
                                               Visibility="{x:Bind ViewModel.IsAccountConnected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEB44;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></controls:SettingsCard.HeaderIcon>
                            <Button x:Uid="SP_AccountConnectBtn" Content="Connexion / Créer un compte…" Click="OpenAccountDialog_Click"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </controls:SettingsCard>

                        <!-- Connecté -->
                        <controls:SettingsCard x:Uid="SP_CloudActiveHeader" Header="Service Cloud PROFstudio (Actif)"
                                               Description="{x:Bind ViewModel.AccountDescription, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.IsAccountConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEB44;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/></controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#1A107C10" BorderBrush="#33107C10" BorderThickness="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#107C10"/>
                                        <TextBlock Text="{x:Bind ViewModel.AccountQuotaText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#107C10"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Uid="SP_AccountProfileBtn" Content="Mon profil &amp; Quota…" Click="OpenAccountDialog_Click" Style="{ThemeResource AccentButtonStyle}"/>
                            </StackPanel>
                        </controls:SettingsCard>

                        <InfoBar Severity="Success" IsOpen="True" IsClosable="False"
                                 x:Uid="SP_ReadyCard" Title="Prêt pour vos cours"
                                 Message="Vos documents sont rédigés et mis en page instantanément via le cloud PROFstudio. Activez le 'Mode Expert' ci-dessus pour configurer manuellement vos propres clés ou modèles."/>
                    </StackPanel>

                    <!-- ───── Vue Expert (Paramétrage avancé) ───── -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.EnableExpertMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             x:Uid="SP_TaskRouting" Title="Routage intelligent par tâche"
                             Message="Chaque tâche de PROFstudio peut utiliser un fournisseur et un modèle différents. Vos clés sont protégées par le Coffre d'identification Windows — jamais dans les fichiers de configuration."/>

                    <controls:SettingsCard x:Uid="SP_MainProvider" Header="Fournisseur IA principal"
                                           Description="Utilisé par défaut pour toute nouvelle tâche ou nouveau modèle.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE99A;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="300"
                                  AutomationProperties.Name="Fournisseur IA principal"
                                  ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedGlobalProvider, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ProviderOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- ───── Clés d'API ───── -->
                    <controls:SettingsExpander x:Uid="SP_ApiKeysHeader" Header="Clés d'API — sécurisées par Windows"
                                               Description="Vos clés sont chiffrées et conservées dans le Coffre d'identification Windows."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">

                            <!-- ══ Google AI Studio ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="💠" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Google AI Studio (Gemini)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource StatusPositiveFgBrush}"/>
                                                <TextBlock x:Uid="SP_VaultSecured" Text="Coffre d'identification Windows" FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}"
                                                Visibility="{x:Bind ViewModel.IsGeminiKeyConfigured, Mode=OneWay}">
                                            <TextBlock x:Uid="SP_KeyConfigured" Text="● Clé configurée" FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="GeminiPasswordBox" x:Uid="SP_GeminiPlaceholder" PlaceholderText="Collez votre clé d'API Google AI Studio…"
                                                 PasswordRevealMode="Peek" PasswordChanged="GeminiPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton x:Uid="SP_GetKeyBtn" Content="Obtenir une clé ↗" NavigateUri="https://aistudio.google.com/app/apikey" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Uid="SP_TestBtn" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="aistudio"/>
                                        <Button Grid.Column="2" x:Uid="SP_ClearBtn" Content="Effacer" Tag="aistudio" Click="ClearApiKey_Click" ToolTipService.ToolTip="Supprime la clé du coffre Windows"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.GeminiState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.GeminiState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.GeminiState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ OpenAI ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🤖" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="OpenAI (GPT)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource StatusPositiveFgBrush}"/>
                                                <TextBlock x:Uid="SP_VaultSecured" Text="Securisé sur votre appareil." FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}"
                                                Visibility="{x:Bind ViewModel.IsOpenAiKeyConfigured, Mode=OneWay}">
                                            <TextBlock x:Uid="SP_KeyConfigured" Text="● Clé configurée" FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="OpenAiPasswordBox" x:Uid="SP_OpenAiPlaceholder" PlaceholderText="sk-…"
                                                 PasswordRevealMode="Peek" PasswordChanged="OpenAiPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton x:Uid="SP_GetKeyBtn" Content="Obtenir une clé ↗" NavigateUri="https://platform.openai.com/api-keys" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Uid="SP_TestBtn" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="openai"/>
                                        <Button Grid.Column="2" x:Uid="SP_ClearBtn" Content="Effacer" Tag="openai" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.OpenAiState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.OpenAiState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.OpenAiState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Anthropic (Masqué jusqu'à implémentation de l'adaptateur) ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🧠" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Anthropic (Claude)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource StatusPositiveFgBrush}"/>
                                                <TextBlock x:Uid="SP_VaultSecured" Text="Securisé sur votre appareil." FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}"
                                                Visibility="{x:Bind ViewModel.IsAnthropicKeyConfigured, Mode=OneWay}">
                                            <TextBlock x:Uid="SP_KeyConfigured" Text="● Clé configurée" FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="AnthropicPasswordBox" x:Uid="SP_AnthropicPlaceholder" PlaceholderText="sk-ant-…"
                                                 PasswordRevealMode="Peek" PasswordChanged="AnthropicPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton x:Uid="SP_GetKeyBtn" Content="Obtenir une clé ↗" NavigateUri="https://console.anthropic.com/settings/keys" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Uid="SP_TestBtn" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="anthropic"/>
                                        <Button Grid.Column="2" x:Uid="SP_ClearBtn" Content="Effacer" Tag="anthropic" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.AnthropicState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.AnthropicState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.AnthropicState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Proxy Ollama / endpoint personnalisé ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🦙" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Uid="SP_LocalServer" Text="Serveur local (Ollama, LM Studio…)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}">
                                            <TextBlock x:Uid="SP_LocalServerZeroData" Text="Aucune donnée ne quitte le poste" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBox x:Uid="SP_LocalServerUrl" Header="Adresse du serveur (compatible OpenAI)"
                                             Text="{x:Bind ViewModel.ProxyBaseUrl, Mode=TwoWay}"
                                             PlaceholderText="http://localhost:11434/v1"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Uid="SP_LocalServerModel" Header="Modèle utilisé (ex : mistral)"
                                                 Text="{x:Bind ViewModel.CustomEndpointModel, Mode=TwoWay}"/>
                                        <PasswordBox Grid.Column="1" x:Name="ProxyPasswordBox" x:Uid="SP_LocalServerKey" Header="Clé d'API (optionnelle)"
                                                     PasswordRevealMode="Peek" PasswordChanged="ProxyPasswordBox_PasswordChanged"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Tester la connexion" x:Uid="SP_TestBtn" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="proxy"/>
                                        <Button Grid.Column="1" x:Uid="SP_LocalServerLoadModels" Content="🔍 Charger les modèles disponibles" Command="{x:Bind ViewModel.ScanProxyModelsCommand}"/>
                                        <Button Grid.Column="2" x:Uid="SP_ClearBtn" Content="Effacer la clé" Tag="proxy" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.ProxyState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.ProxyState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.ProxyState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Vertex AI ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="☁️" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Uid="SP_VertexHeader" Text="Google Cloud Vertex AI (entreprise)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Uid="SP_VertexProject" Header="Identifiant du projet Google Cloud" Text="{x:Bind ViewModel.VertexProject, Mode=TwoWay}"/>
                                        <TextBox Grid.Column="1" x:Uid="SP_VertexRegion" Header="Région" Text="{x:Bind ViewModel.VertexRegion, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Tester la connexion" x:Uid="SP_TestBtn" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="vertex"/>
                                        <ProgressRing Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.VertexState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.VertexState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.VertexState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Vercel AI Gateway ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="▲" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Uid="SP_VercelHeader" Text="Vercel AI Gateway — un point d'accès multi-modèles" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{ThemeResource StatusPositiveFgBrush}"/>
                                                <TextBlock x:Uid="SP_VaultSecured" Text="Coffre" FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}"
                                                Visibility="{x:Bind ViewModel.IsVercelKeyConfigured, Mode=OneWay}">
                                            <TextBlock x:Uid="SP_KeyConfigured" Text="● Clé configurée" FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="VercelPasswordBox" x:Uid="SP_VercelPlaceholder" PlaceholderText="Clé Vercel AI Gateway…"
                                                 PasswordRevealMode="Peek" PasswordChanged="VercelPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton x:Uid="SP_GetKeyBtn" Content="Obtenir une clé ↗" NavigateUri="https://vercel.com/ai-gateway" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Uid="SP_TestBtn" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="vercel"/>
                                        <Button Grid.Column="2" x:Uid="SP_ClearBtn" Content="Effacer" Tag="vercel" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.VercelState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.VercelState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.VercelState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Uid="SP_TestAllProviders" Content="⚡ Tester tous les fournisseurs"
                                    Command="{x:Bind ViewModel.TestAllConnectionsCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- ───── Matrice de routage 7 tâches (Avancé) ───── -->
                    <controls:SettingsExpander x:Uid="SP_RoutingMatrix" Header="Matrice de routage détaillée (Mode avancé)"
                                               Description="Personnalisez le modèle utilisé pour chaque tâche spécifique (rédaction, quiz, assistant)."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <Grid ColumnSpacing="12" Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.7*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="SP_MatrixColTask" Text="TÂCHE" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" x:Uid="SP_MatrixColProvider" Text="FOURNISSEUR" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" x:Uid="SP_MatrixColModel" Text="MODÈLE (modifiable à la main)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.RoutingMatrix, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="4,4"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ModelRoutingItem">
                                        <Grid ColumnSpacing="12" Padding="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.7*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Icon}" FontSize="18" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ItemsSource="{x:Bind ProviderOptions}"
                                                      SelectedItem="{x:Bind SelectedProvider, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:ProviderOption">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Icon}"/>
                                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      IsEditable="True"
                                                      ItemsSource="{x:Bind AvailableModels, Mode=OneWay}"
                                                      Text="{x:Bind Model, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- ───── Créativité ───── -->
                    <controls:SettingsExpander x:Uid="SP_Creativity" Header="Créativité des réponses"
                                               Description="Réglage fin du niveau de créativité : 0 = réponse fidèle, 2 = réponse très libre.">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9CA;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📝 Génération de fiches" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GenerationTemperatureLabel, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="2" StepFrequency="0.05" TickFrequency="0.5" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.GenerationTemperature, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SP_TaskIntent" Text="🎯 Classification d'intention" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.IntentTemperatureLabel, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="2" StepFrequency="0.05" TickFrequency="0.5" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.IntentTemperature, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SP_TaskAssistant" Text="💬 Assistant conversationnel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AssistantTemperatureLabel, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                 <Slider Minimum="0" Maximum="2" StepFrequency="0.05" TickFrequency="0.5" TickPlacement="Outside"
                                         Value="{x:Bind ViewModel.AssistantTemperature, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsExpander>
                    </StackPanel>
                </StackPanel>

                <!-- ═════════════════════════════════���════════════ -->
                <!-- ONGLET 3 · DOSSIERS &amp; EMPLACEMENTS           -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelFolders" Spacing="12" Visibility="Collapsed">

                    <TextBlock x:Uid="SP_StorageLocations" Text="Emplacements de stockage" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsExpander x:Uid="SP_GuidesFolder" Header="Guides pédagogiques (PDF)"
                                               Description="Sources analysées pour la table des matières et le contexte pédagogique."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8A5;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.GuidesDir, Mode=OneWay}" IsReadOnly="True"
                                         PlaceholderText="Aucun dossier sélectionné"/>
                                <Button Grid.Column="1" x:Uid="SP_BrowseBtn" Content="Parcourir…" Command="{x:Bind ViewModel.BrowseGuidesDirCommand}"/>
                                <Button Grid.Column="2" x:Uid="SP_OpenBtn" Content="Ouvrir" Command="{x:Bind ViewModel.OpenGuidesFolderCommand}">
									<Button.KeyboardAccelerators>
										<KeyboardAccelerator Key="O" Modifiers="Control,Shift"/>
									</Button.KeyboardAccelerators>                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsGuidesAccessPersistent, Mode=OneWay}">
                                <Border Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource StatusPositiveBgBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource StatusPositiveFgBrush}"/>
                                        <TextBlock x:Uid="SP_PermanentAccess" Text="Accès permanent accordé" FontSize="12" Foreground="{ThemeResource StatusPositiveFgBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander x:Uid="SP_ExportsFolder" Header="Dossier des exportations (PDF, DOCX, RTF)"
                                               Description="Destination par défaut de toutes vos fiches exportées.">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B7;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.ExportsDir, Mode=OneWay}" IsReadOnly="True"
                                         PlaceholderText="Aucun dossier sélectionné"/>
                                <Button Grid.Column="1" Content="Parcourir…" Command="{x:Bind ViewModel.BrowseExportsDirCommand}"/>
                                <Button Grid.Column="2" Content="Ouvrir" Command="{x:Bind ViewModel.OpenExportsFolderCommand}"/>
                            </Grid>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <TextBlock x:Uid="SP_CacheMaintenance" Text="Cache &amp; maintenance" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard x:Uid="SP_TocCache" Header="Cache de la table des matières"
                                           Description="{x:Bind ViewModel.TocCacheSizeText, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F3;"/></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsCacheBusy, Mode=OneWay}"/>
                            <Button Content="Ouvrir" Command="{x:Bind ViewModel.OpenTocCacheFolderCommand}"/>
                            <Button x:Uid="SP_ClearCacheBtn" Content="Vider le cache" Click="ClearCache_Click"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="SP_AppLogs" Header="Journaux de l'application"
                                           Description="Consultez les journaux locaux en cas de comportement inattendu.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsCard.HeaderIcon>
                        <Button x:Uid="SP_OpenLogsBtn" Content="Ouvrir le dossier des journaux" Command="{x:Bind ViewModel.OpenLogsFolderCommand}"/>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 5 · CONFIDENTIALITÉ                    -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelPrivacy" Spacing="12" Visibility="Collapsed">

                    <!-- Carte de flux de données -->
                    <Border Padding="18" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE83D;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="SP_GdprHeader" Text="Confidentialité — le parcours de vos données" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Uid="SP_GdprSubtitle" Text="Transparence totale sur ce qui transite, où, et comment c'est protégé."
                                               Style="{StaticResource CaptionNoteStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprRequest" Text="Votre demande" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprSentToAi" Text="Transmise à l'IA" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="→" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprHttps" Text="HTTPS chiffré" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprSecureConn" Text="Connexion sécurisée" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="→" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="☁️" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprAiService" Text="Service IA" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprDrafting" Text="Rédaction du cours" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="→" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprYourDocs" Text="Vos documents" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock x:Uid="SP_GdprLocalOnly" Text="Uniquement sur ce PC" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="• Aucune donnée n'est vendue, partagée ou utilisée pour entraîner des modèles tiers par PROFstudio." Style="{StaticResource CaptionNoteStyle}"/>
                                <TextBlock x:Uid="SP_GdprBullet2" Text="• Vos clés d'API ne quittent jamais votre appareil." Style="{StaticResource CaptionNoteStyle}"/>
                                <TextBlock x:Uid="SP_GdprBullet3" Text="• Recommandation : ne saisissez jamais de données nominatives d'élèves dans les prompts." Style="{StaticResource CaptionNoteStyle}"/>
                                <TextBlock x:Uid="SP_GdprBullet4" Text="• Option 100 % hors-ligne disponible via le fournisseur « Proxy local / Ollama »." Style="{StaticResource CaptionNoteStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <controls:SettingsCard x:Uid="SP_Telemetry" Header="Télémétrie anonyme"
                                           Description="Désactivée par défaut. Si activée : statistiques d'usage agrégées uniquement, sans contenu pédagogique ni identifiant.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F5;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.TelemetryEnabled, Mode=TwoWay}" OnContent="Autorisée" OffContent="Refusée"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="SP_TwoPass" Header="Génération en deux passes (expérimental)"
                                           Description="Deux passages de rédaction + une relecture automatique pour une meilleure qualité. Consomme environ deux fois plus de ressources.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ExpMultiPassGen, Mode=TwoWay}" OnContent="Activé" OffContent="Désactivé"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="SP_LogLevel" Header="Niveau de journalisation (diagnostic)"
                                           Description="Verbosité des journaux locaux. « Information » recommandé au quotidien.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="200" SelectedItem="{x:Bind ViewModel.DiagnosticLogLevel, Mode=TwoWay}"
                                  ItemsSource="{x:Bind ViewModel.LogLevels, Mode=OneWay}"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Uid="SP_Retention" Header="Rétention de l'historique des fiches"
                                           Description="Durée de conservation en jours. 0 = conservation illimitée.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;"/></controls:SettingsCard.HeaderIcon>
                        <NumberBox Minimum="0" Maximum="365" SpinButtonPlacementMode="Inline" MinWidth="140"
                                   Value="{x:Bind ViewModel.HistoryRetentionDays, Mode=TwoWay}"/>
                    </controls:SettingsCard>

                    <controls:SettingsExpander x:Uid="SP_DiagMaintenance" Header="Diagnostic &amp; maintenance"
                                               Description="Exportez un pack de diagnostic complet pour le support technique.">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <TextBlock x:Uid="SP_DiagPackNote" Style="{StaticResource CaptionNoteStyle}"
                                       Text="Le pack (.zip) contient les journaux, la configuration et l'état du routage IA. Les clés d'API et tous les secrets sont systématiquement expurgés avant l'archivage."/>
                            <Button x:Uid="SP_ExportDiagBtn" Content="📦 Exporter le pack de diagnostic (.zip)"
                                    Command="{x:Bind ViewModel.ExportDiagnosticBundleCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- Zone de danger -->
                    <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource StatusCriticalFgBrush}" Background="{ThemeResource StatusCriticalBgBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SP_DangerZone" Text="⚠ Zone de danger" FontWeight="SemiBold" Foreground="{ThemeResource StatusCriticalFgBrush}"/>
                            <TextBlock x:Uid="SP_DangerZoneDesc" Text="Rétablit tous les paramètres d'usine (thème, routage IA, styles, prompts). Vos clés d'API et vos dossiers sont conservés."
                                       Style="{StaticResource CaptionNoteStyle}"/>
                            <Button x:Uid="SP_ResetAllBtn" Content="Réinitialiser tous les paramètres" Click="ResetAll_Click" HorizontalAlignment="Left"
                                    Foreground="{ThemeResource StatusCriticalFgBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 6 · PROMPTS &amp; RACCOURCIS              -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelPrompts" Spacing="12" Visibility="Collapsed">

                    <TextBlock x:Uid="SP_PromptsHeader" Text="Modèles de prompts personnalisables" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Adaptez les instructions envoyées aux modèles IA. Variables disponibles : {Niveau}, {Matiere}, {Sujet}, {Consigne}."
                               Style="{StaticResource CaptionNoteStyle}"/>

                    <Grid ColumnSpacing="14" MinHeight="320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListView Grid.Column="0"
                                  ItemsSource="{x:Bind ViewModel.PromptTemplates, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPromptTemplate, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PromptTemplateItem">
                                    <StackPanel Padding="6,4" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Column="1" Padding="14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedPromptTemplate.Name, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Uid="SP_ResetPromptBtn" Content="↺ Réinitialiser ce modèle"
                                            Command="{x:Bind ViewModel.ResetPromptTemplateCommand}"/>
                                </Grid>
                                <TextBox Text="{x:Bind ViewModel.SelectedPromptTemplate.Content, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220"
                                         FontFamily="Cascadia Code, Consolas" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Uid="SP_PromptSaveNote" Text="Les modifications sont enregistrées avec le bouton « Enregistrer les paramètres » (Ctrl+S)."
                                           Style="{StaticResource CaptionNoteStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Uid="SP_ShortcutsHeader" Text="Raccourcis clavier" Style="{StaticResource SectionHeaderStyle}"/>
                    <controls:SettingsCard x:Uid="SP_ShortcutEditor" Header="Raccourcis clavier de l'application"
                                           Description="Combinaisons de touches rapides pour optimiser votre flux de travail. Modifiez les touches ci-dessous puis enregistrez.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;"/></controls:SettingsCard.HeaderIcon>
                        <Button x:Uid="SP_ResetShortcutsBtn" Content="↺ Tout rétablir" Command="{x:Bind ViewModel.ResetShortcutsCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"/>
                    </controls:SettingsCard>
                    <ListView ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:KeyboardShortcutItem">
                                <Grid ColumnSpacing="12" Padding="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Action}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBox Text="{x:Bind Keys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Code, Consolas" FontSize="12" FontWeight="SemiBold"
                                                 MinWidth="140" MaxWidth="180" HorizontalContentAlignment="Center"
                                                 AutomationProperties.Name="{x:Bind Action}"/>
                                        <Button Style="{ThemeResource SubtleButtonStyle}" Padding="6,4"
                                                Command="{x:Bind ResetCommand}" ToolTipService.ToolTip="Rétablir la touche par défaut"
                                                AutomationProperties.Name="Rétablir le raccourci par défaut">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ONGLET 4 · STYLES & PERSONNALISATION (STUDIO 2 COLONNES) -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelStyles" Grid.Row="2" Margin="24,8,24,14" ColumnSpacing="20" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <!-- Colonne gauche : Thèmes & Personnalisation (480px) -->
                <ColumnDefinition Width="480" MinWidth="400" MaxWidth="560"/>
                <!-- Colonne droite : Aperçu en direct temps réel (*) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── COLONNE GAUCHE (Scrollable) ── -->
            <ScrollViewer Grid.Column="0" Padding="0,0,12,12">
                <StackPanel Spacing="14">

                    <!-- En-tête de section -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="SP_ThemeGallery" Text="Galerie de thèmes" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                            <TextBlock x:Uid="SP_ThemeGallerySubtitle" Text="Glissez-déposez pour réorganiser, personnalisez les couleurs et créez vos propres styles."
                                       Style="{StaticResource CaptionNoteStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Margin="0,0,6,0"
                                Command="{x:Bind ViewModel.ResetThemesToDefaultCommand}"
                                ToolTipService.ToolTip="Rétablir les thèmes par défaut d'origine"
                                AutomationProperties.Name="Rétablir les thèmes d'usine">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        </Button>
                        <Button Grid.Column="2" Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.CreateNewThemeCommand}"
                                ToolTipService.ToolTip="Créer un nouveau thème sur-mesure"
                                AutomationProperties.Name="Créer un nouveau thème">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                <TextBlock Text="Nouveau thème" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Galerie de thèmes — glisser-déposer interactif -->
                    <GridView x:Name="ThemeGridView"
                              ItemsSource="{x:Bind ViewModel.StylePresets, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                              SelectionMode="Single" IsItemClickEnabled="False">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:StylePresetItem">
                                <Border Width="144" Height="184" CornerRadius="8" BorderThickness="1"
                                        Opacity="{x:Bind VisibleOpacity, Mode=OneWay}"
                                        CanDrag="True" AllowDrop="True"
                                        DragStarting="ThemeCard_DragStarting"
                                        DragOver="ThemeCard_DragOver"
                                        DragLeave="ThemeCard_DragLeave"
                                        Drop="ThemeCard_Drop"
                                        Tapped="ThemeCard_Tapped"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="52"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- En-tête de tuile avec icône, nom et poignée de glissement -->
                                        <Border Grid.Row="0" CornerRadius="7,7,0,0" Background="{x:Bind PrimaryBrush, Mode=OneWay}">
                                            <Grid Padding="6,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Icon, Mode=OneWay}" FontSize="15" VerticalAlignment="Center"/>
                                                    <Border Visibility="{x:Bind DefaultBadgeVisibility, Mode=OneWay}"
                                                            Background="#E6FFFFFF" CornerRadius="4" Padding="3,1" VerticalAlignment="Center">
                                                        <TextBlock Text="★" FontSize="9" FontWeight="Bold" Foreground="#1E3A8A"/>
                                                    </Border>
                                                </StackPanel>
                                                
                                                <!-- Poignée de glisser-déposer -->
                                                <FontIcon Glyph="&#xE700;" FontSize="10" Foreground="White" Opacity="0.7"
                                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>

                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="11.5"
                                                           VerticalAlignment="Bottom" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>

                                        <!-- Description et aperçu de palette -->
                                        <StackPanel Grid.Row="1" Padding="6,4" Spacing="2">
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="10" TextWrapping="Wrap" MaxHeight="36"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0" VerticalAlignment="Bottom">
                                                <Ellipse Width="8" Height="8" Fill="{x:Bind PrimaryBrush, Mode=OneWay}"/>
                                                <Ellipse Width="8" Height="8" Fill="{x:Bind SecondaryBrush, Mode=OneWay}"/>
                                                <Ellipse Width="8" Height="8" Fill="{x:Bind AccentBrush, Mode=OneWay}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Barre d'outils de la tuile (Déplacer, Par défaut, Masquer, Dupliquer, Supprimer) -->
                                        <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="0,0,7,7" Padding="2,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource ToolbarIconButtonStyle}" Padding="3,2" MinWidth="22" MinHeight="22"
                                                        Click="MoveThemeLeft_Click" Tag="{Binding}" ToolTipService.ToolTip="Déplacer vers la gauche"
                                                        AutomationProperties.Name="Déplacer vers la gauche">
                                                    <FontIcon Glyph="&#xE76B;" FontSize="10"/>
                                                </Button>
                                                <Button Grid.Column="1" Style="{StaticResource ToolbarIconButtonStyle}" Padding="3,2" MinWidth="22" MinHeight="22"
                                                        Click="MoveThemeRight_Click" Tag="{Binding}" ToolTipService.ToolTip="Déplacer vers la droite"
                                                        AutomationProperties.Name="Déplacer vers la droite">
                                                    <FontIcon Glyph="&#xE76C;" FontSize="10"/>
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}" Padding="3,2" MinWidth="22" MinHeight="22"
                                                        Click="SetAsDefaultTheme_Click" Tag="{Binding}" ToolTipService.ToolTip="Définir comme style par défaut"
                                                        AutomationProperties.Name="Définir par défaut">
                                                    <FontIcon Glyph="&#xE734;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                </Button>
                                                <Button Grid.Column="4" Style="{StaticResource ToolbarIconButtonStyle}" Padding="3,2" MinWidth="22" MinHeight="22"
                                                        Click="DuplicateTheme_Click" Tag="{Binding}" ToolTipService.ToolTip="Dupliquer ce thème"
                                                        AutomationProperties.Name="Dupliquer le thème">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="10"/>
                                                </Button>
                                                <Button Grid.Column="5" Style="{StaticResource ToolbarIconButtonStyle}" Padding="3,2" MinWidth="22" MinHeight="22"
                                                        Click="ToggleThemeVisibility_Click" Tag="{Binding}" ToolTipService.ToolTip="Afficher / Masquer"
                                                        AutomationProperties.Name="Afficher ou masquer la tuile">
                                                    <FontIcon Glyph="&#xE890;" FontSize="10"/>
                                                </Button>
                                                <Button Grid.Column="6" Style="{StaticResource ToolbarIconButtonStyle}" Padding="3,2" MinWidth="22" MinHeight="22"
                                                        Click="DeleteTheme_Click" Tag="{Binding}" ToolTipService.ToolTip="Supprimer ce thème"
                                                        Visibility="{x:Bind CustomVisibility, Mode=OneWay}"
                                                        AutomationProperties.Name="Supprimer le thème personnalisé">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Info Style par défaut -->
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             x:Uid="SP_DefaultStyleTitle" Title="Style par défaut pour les futures fiches :"
                             Message="{x:Bind ViewModel.DefaultStyleLabel, Mode=OneWay}"/>

                    <!-- ───── StyleBuilder — Personnalisation complète ───── -->
                    <controls:SettingsExpander x:Uid="SP_StyleBuilder" Header="StyleBuilder — Personnalisation du thème"
                                               Description="Personnalisez couleurs, typographie, en-tête et marges du thème sélectionné."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE790;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">

                            <!-- Édition du nom et de l'icône (si thème personnalisé) -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsSelectedThemeCustom, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Identité du thème personnalisé" FontWeight="SemiBold" FontSize="13"/>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{x:Bind ViewModel.BuilderThemeIcon, Mode=OneWay}" FontSize="18" Padding="10,6"
                                            ToolTipService.ToolTip="Changer l'icône du thème">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <GridView ItemsSource="{x:Bind ViewModel.QuickEmojiIcons, Mode=OneWay}"
                                                          SelectionMode="None" MaxWidth="220">
                                                    <GridView.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Button Content="{x:Bind}" FontSize="16" Padding="6"
                                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                                    Click="EmojiButton_Click" Tag="{x:Bind}"/>
                                                        </DataTemplate>
                                                    </GridView.ItemTemplate>
                                                </GridView>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBox Grid.Column="1" Header="Nom du thème"
                                             Text="{x:Bind ViewModel.BuilderThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="ex. Mon Style CM2"/>
                                </Grid>
                            </StackPanel>

                            <!-- Palette de 3 couleurs harmoniques -->
                            <TextBlock x:Uid="SP_ColorPalette" Text="Palette chromatique" FontWeight="SemiBold" FontSize="13"/>
                            
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Primaire -->
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Padding="8,6"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Uid="SP_PrimaryColor" Text="Couleur primaire (Titres &amp; Bandeaux)" FontWeight="SemiBold" FontSize="13"/>
                                                <ColorPicker Color="{x:Bind ViewModel.BuilderPrimaryColor, Mode=TwoWay}"
                                                             IsAlphaEnabled="False" IsHexInputVisible="True" IsColorPreviewVisible="True"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.BuilderPrimaryColor, Mode=OneWay}"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="SP_PrimaryLabel" Text="Primaire" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.BuilderPrimaryHex, Mode=OneWay}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Secondaire -->
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Padding="8,6"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Uid="SP_SecondaryColor" Text="Couleur secondaire (Sous-titres &amp; Encadrés)" FontWeight="SemiBold" FontSize="13"/>
                                                <ColorPicker Color="{x:Bind ViewModel.BuilderSecondaryColor, Mode=TwoWay}"
                                                             IsAlphaEnabled="False" IsHexInputVisible="True" IsColorPreviewVisible="True"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.BuilderSecondaryColor, Mode=OneWay}"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="SP_SecondaryLabel" Text="Secondaire" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.BuilderSecondaryHex, Mode=OneWay}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Accent -->
                                <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="8,6"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Uid="SP_AccentColorLabel" Text="Accentuation (Objectifs &amp; Surlignages)" FontWeight="SemiBold" FontSize="13"/>
                                                <ColorPicker Color="{x:Bind ViewModel.BuilderAccentColor, Mode=TwoWay}"
                                                             IsAlphaEnabled="False" IsHexInputVisible="True" IsColorPreviewVisible="True"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.BuilderAccentColor, Mode=OneWay}"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="SP_AccentLabel" Text="Accent" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind ViewModel.BuilderAccentHex, Mode=OneWay}" FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Palettes rapides harmonieuses -->
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="SP_PaletteSuggestions" Text="Harmonies chromatiques suggérées :" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="ocean" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#1E3A8A"/><Ellipse Width="10" Height="10" Fill="#2563EB"/><Ellipse Width="10" Height="10" Fill="#D97706"/>
                                                <TextBlock Text="Océan" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="forest" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#064E3B"/><Ellipse Width="10" Height="10" Fill="#059669"/><Ellipse Width="10" Height="10" Fill="#D97706"/>
                                                <TextBlock Text="Émeraude" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="purple" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#311042"/><Ellipse Width="10" Height="10" Fill="#6D28D9"/><Ellipse Width="10" Height="10" Fill="#F59E0B"/>
                                                <TextBlock Text="Pourpre" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="terracotta" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#7C2D12"/><Ellipse Width="10" Height="10" Fill="#C2410C"/><Ellipse Width="10" Height="10" Fill="#D97706"/>
                                                <TextBlock Text="Terracotta" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="slate" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#0F172A"/><Ellipse Width="10" Height="10" Fill="#334155"/><Ellipse Width="10" Height="10" Fill="#0284C7"/>
                                                <TextBlock Text="Ardoise" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="ruby" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#881337"/><Ellipse Width="10" Height="10" Fill="#BE123C"/><Ellipse Width="10" Height="10" Fill="#D97706"/>
                                                <TextBlock Text="Rubis" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="pastel" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#1E40AF"/><Ellipse Width="10" Height="10" Fill="#3B82F6"/><Ellipse Width="10" Height="10" Fill="#EC4899"/>
                                                <TextBlock Text="Pastel" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="8,4" Click="PaletteChip_Click" Tag="mono" Style="{ThemeResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="10" Height="10" Fill="#111827"/><Ellipse Width="10" Height="10" Fill="#374151"/><Ellipse Width="10" Height="10" Fill="#6B7280"/>
                                                <TextBlock Text="Noir &amp; Blanc" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Traitement d'en-tête -->
                            <TextBlock x:Uid="SP_HeaderStyle" Text="Style de l'en-tête du document" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.HeaderLayoutOptions, Mode=OneWay}"
                                      SelectedValue="{x:Bind ViewModel.BuilderHeaderLayout, Mode=TwoWay}"
                                      SelectedValuePath="Key">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:HeaderLayoutOption">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Typographie & Arrondis -->
                            <TextBlock x:Uid="SP_TypographyBorders" Text="Typographie &amp; Encadrés" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Uid="SP_DocFont" Header="Police du document" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.FontOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.BuilderFontFamily, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="1" x:Uid="SP_CornerRadius" Header="Arrondi (px)" Minimum="0" Maximum="24"
                                           SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderCornerRadius, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Marges de page -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="SP_PageMargins" Text="Marges de page (mm)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="Compact" FontSize="11" Padding="6,2" Style="{ThemeResource SubtleButtonStyle}"
                                            Command="{x:Bind ViewModel.ApplyQuickMarginsCommand}" CommandParameter="compact"/>
                                    <Button Content="Standard" FontSize="11" Padding="6,2" Style="{ThemeResource SubtleButtonStyle}"
                                            Command="{x:Bind ViewModel.ApplyQuickMarginsCommand}" CommandParameter="normal"/>
                                    <Button Content="Aéré" FontSize="11" Padding="6,2" Style="{ThemeResource SubtleButtonStyle}"
                                            Command="{x:Bind ViewModel.ApplyQuickMarginsCommand}" CommandParameter="wide"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" x:Uid="SP_MarginTop" Header="Haut" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginTop, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="1" x:Uid="SP_MarginBottom" Header="Bas" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginBottom, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="2" x:Uid="SP_MarginLeft" Header="Gauche" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginLeft, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="3" x:Uid="SP_MarginRight" Header="Droite" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginRight, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Actions du StyleBuilder -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button Style="{ThemeResource AccentButtonStyle}" Padding="14,6"
                                        Command="{x:Bind ViewModel.SetAsDefaultThemeCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedPreset, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE734;" FontSize="12"/>
                                        <TextBlock Text="Définir comme style par défaut" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- ───── Générateur de style par IA ───── -->
                    <controls:SettingsExpander x:Uid="SP_InferStylePdf" Header="✨ Suggérer une palette de style"
                                               Description="Applique une harmonie de couleurs et typographie prédéfinie au StyleBuilder.">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE99A;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <TextBlock x:Uid="SP_InferStylePdfNote" Style="{StaticResource CaptionNoteStyle}"
                                       Text="Sélectionnez un document modèle ou activez la suggestion pour charger une palette harmonieuse."/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Uid="SP_AnalyzePdfBtn" Content="🎨 Suggérer une palette…" Click="AnalyzeStylePdf_Click"
                                        Style="{ThemeResource DefaultButtonStyle}"/>
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsAnalyzingStyle, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ViewModel.StyleAnalysisStatus, Mode=OneWay}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBox Text="{x:Bind ViewModel.GeneratedCss, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Cascadia Code, Consolas" FontSize="12" AcceptsReturn="True"
                                     TextWrapping="NoWrap" MinHeight="120"
                                     Visibility="{x:Bind ViewModel.HasGeneratedCss, Mode=OneWay}"
                                     x:Uid="SP_GeneratedStyleSheet" Header="Feuille de style générée"/>
                        </StackPanel>
                    </controls:SettingsExpander>
                </StackPanel>
            </ScrollViewer>

            <!-- ── COLONNE DROITE : APERÇU TEMPS RÉEL ── -->
            <Border Grid.Column="1" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête de l'aperçu -->
                    <Border Grid.Row="0" Padding="14,10" BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="9,9,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE890;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock x:Uid="SP_LivePreview" Text="Aperçu en direct" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource PillBadgeStyle}" Background="{ThemeResource LayerFillColorAltBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.DefaultStyleLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Padding="8,5"
                                    Click="RefreshPreview_Click" ToolTipService.ToolTip="Actualiser le rendu">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                    <TextBlock x:Uid="SP_RefreshPreviewBtn" Text="Actualiser" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Zone de document WebView2 -->
                    <Border Grid.Row="1" Padding="12" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,0,9,9">
                        <Grid>
                            <Border CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="White">
                                <WebView2 x:Name="StylePreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>

                            <!-- Fallback runtime WebView2 -->
                            <StackPanel x:Name="WebViewFallback" Visibility="Collapsed" Spacing="8" Padding="24"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock x:Uid="SP_WebView2Required" Text="Runtime WebView2 requis pour l'aperçu en direct." FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <HyperlinkButton x:Uid="SP_DownloadWebView2Btn" Content="Télécharger le runtime WebView2 ↗" HorizontalAlignment="Center"
                                                 NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- BARRE D'ACTION INFÉRIEURE                                -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{x:Bind ViewModel.LastSavedText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"/>
                    <Button Style="{ThemeResource AccentButtonStyle}" Padding="24,10"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            ToolTipService.ToolTip="Enregistrer (Ctrl+S)" x:Uid="SP_SaveButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock x:Name="SaveLabel" x:Uid="SP_SaveLabel" Text="Enregistrer les paramètres"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
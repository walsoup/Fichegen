<Page
    x:Class="FicheGen.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:FicheGen.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- ═══════ Styles réutilisables ═══════ -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="CaptionNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ExpanderInnerPanelStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="14"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <!-- Pilule de statut générique -->
        <Style x:Key="PillBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Raccourci global Ctrl+S -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- EN-TÊTE DE PAGE                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="24,20,24,4" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="White"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Paramètres" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Text="Configurez PROFstudio : apparence, intelligence artificielle, styles de documents et confidentialité."
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                <TextBlock Text="placeholder" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- BARRE D'ONGLETS (SelectorBar Fluent 2)                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <SelectorBar x:Name="SettingsTabs" Grid.Row="1" Margin="24,10,24,0"
                     SelectionChanged="SettingsTabs_SelectionChanged"
                     AutomationProperties.Name="Sections des paramètres">
            <SelectorBarItem x:Name="TabGeneral" Text="Général">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE771;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabAi" Text="IA &amp; Routage">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE99A;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabFolders" Text="Dossiers">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE8B7;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabStyles" Text="Styles">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE790;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabPrivacy" Text="Confidentialité">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE72E;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="TabPrompts" Text="Prompts &amp; Raccourcis">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE70F;" FontSize="14"/></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ZONE DE CONTENU                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" Padding="24,14,24,20">
            <Grid MaxWidth="1020" HorizontalAlignment="Left">

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 1 · GÉNÉRAL &amp; APPARENCE               -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelGeneral" Spacing="12" Visibility="Visible">

                    <TextBlock Text="Profil de l'enseignant·e" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Nom / Identité" Description="Affiché dans l'en-tête de l'application et sur vos fiches.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;"/></controls:SettingsCard.HeaderIcon>
                        <TextBox MinWidth="260" Text="{x:Bind ViewModel.TeacherName, Mode=TwoWay}" PlaceholderText="ex. M. Dupont / Mme Martin"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="École / Établissement" Description="Nom de l'établissement imprimé sur les documents générés.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE80F;"/></controls:SettingsCard.HeaderIcon>
                        <TextBox MinWidth="260" Text="{x:Bind ViewModel.SchoolName, Mode=TwoWay}" PlaceholderText="ex. École Louise-Michel"/>
                    </controls:SettingsCard>

                    <TextBlock Text="Personnalisation de l'interface" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Thème de l'application"
                                           Description="Appliqué immédiatement à toute l'interface PROFstudio.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="260"
                                  ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ThemeOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Couleur d'accentuation"
                                           Description="Teinte de marque PROFstudio — appliquée globalement au prochain démarrage.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="260"
                                  ItemsSource="{x:Bind ViewModel.AccentOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:AccentOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse Width="16" Height="16" Fill="{x:Bind Brush}"/>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Langue de l'interface"
                                           Description="La langue de l'application — nécessite un redémarrage pour être pleinement appliquée.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="260"
                                  ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:LanguageOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <TextBlock Text="Préférences pédagogiques" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Niveau scolaire par défaut"
                                           Description="Présélectionné automatiquement à chaque nouvelle fiche.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BE;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="180" SelectedItem="{x:Bind ViewModel.DefaultClassLevel, Mode=TwoWay}">
                            <x:String>CP</x:String><x:String>CE1</x:String><x:String>CE2</x:String>
                            <x:String>CM1</x:String><x:String>CM2</x:String>
                            <x:String>6e</x:String><x:String>5e</x:String><x:String>4e</x:String><x:String>3e</x:String>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Matière par défaut"
                                           Description="Champ libre — choisissez dans la liste ou saisissez votre matière.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE70F;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="240" IsEditable="True" Text="{x:Bind ViewModel.DefaultSubject, Mode=TwoWay}">
                            <x:String>Mathématiques</x:String>
                            <x:String>Français</x:String>
                            <x:String>Histoire-Géographie</x:String>
                            <x:String>Sciences et technologie</x:String>
                            <x:String>Langues vivantes</x:String>
                            <x:String>Arts plastiques</x:String>
                            <x:String>Éducation musicale</x:String>
                            <x:String>EPS</x:String>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Dossier d'exportation par défaut"
                                           Description="{x:Bind ViewModel.ExportsDir, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;"/></controls:SettingsCard.HeaderIcon>
                        <Button Content="Gérer les dossiers…" Click="ManageFolders_Click"
                                ToolTipService.ToolTip="Ouvre l'onglet Dossiers &amp; Emplacements"/>
                    </controls:SettingsCard>

                    <TextBlock Text="Démarrage de Windows" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Lancer PROFstudio au démarrage de Windows"
                                           Description="{x:Bind ViewModel.StartupStatusText, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled"
                                      OnContent="Activé" OffContent="Désactivé"
                                      AutomationProperties.Name="Lancer PROFstudio au démarrage"/>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 2 · FOURNISSEURS IA &amp; ROUTAGE         -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelAi" Spacing="12" Visibility="Collapsed">

                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             Title="Routage intelligent par tâche"
                             Message="Chaque tâche de PROFstudio peut utiliser un fournisseur et un modèle différents. Vos clés sont chiffrées dans le Coffre d'identification Windows (DPAPI) — jamais dans les fichiers de configuration."/>

                    <controls:SettingsCard Header="Fournisseur IA principal (Global Provider)"
                                           Description="Utilisé par défaut pour toute nouvelle tâche ou nouveau modèle.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE99A;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="300"
                                  ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedGlobalProvider, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ProviderOption">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="14"/>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- ───── Clés d'API ───── -->
                    <controls:SettingsExpander Header="Clés d'API — sécurisées par Windows"
                                               Description="Chiffrement DPAPI via le Coffre d'identification Windows (Credential Locker)."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">

                            <!-- ══ Google AI Studio ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="💠" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Google AI Studio (Gemini)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="#107C10"/>
                                                <TextBlock Text="Coffre d'identification Windows" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10"
                                                Visibility="{x:Bind ViewModel.IsGeminiKeyConfigured, Mode=OneWay}">
                                            <TextBlock Text="● Clé configurée" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="GeminiPasswordBox" PlaceholderText="Collez votre clé d'API Google AI Studio…"
                                                 PasswordRevealMode="Peek" PasswordChanged="GeminiPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Content="Obtenir une clé ↗" NavigateUri="https://aistudio.google.com/app/apikey" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="aistudio"/>
                                        <Button Grid.Column="2" Content="Effacer" Tag="aistudio" Click="ClearApiKey_Click" ToolTipService.ToolTip="Supprime la clé du coffre Windows"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.GeminiState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.GeminiState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.GeminiState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ OpenAI ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🤖" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="OpenAI (GPT)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="#107C10"/>
                                                <TextBlock Text="Coffre d'identification Windows" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10"
                                                Visibility="{x:Bind ViewModel.IsOpenAiKeyConfigured, Mode=OneWay}">
                                            <TextBlock Text="● Clé configurée" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="OpenAiPasswordBox" PlaceholderText="sk-…"
                                                 PasswordRevealMode="Peek" PasswordChanged="OpenAiPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Content="Obtenir une clé ↗" NavigateUri="https://platform.openai.com/api-keys" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="openai"/>
                                        <Button Grid.Column="2" Content="Effacer" Tag="openai" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.OpenAiState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.OpenAiState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.OpenAiState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Anthropic ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🧠" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Anthropic (Claude)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="#107C10"/>
                                                <TextBlock Text="Coffre d'identification Windows" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10"
                                                Visibility="{x:Bind ViewModel.IsAnthropicKeyConfigured, Mode=OneWay}">
                                            <TextBlock Text="● Clé configurée" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="AnthropicPasswordBox" PlaceholderText="sk-ant-…"
                                                 PasswordRevealMode="Peek" PasswordChanged="AnthropicPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Content="Obtenir une clé ↗" NavigateUri="https://console.anthropic.com/settings/keys" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="anthropic"/>
                                        <Button Grid.Column="2" Content="Effacer" Tag="anthropic" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.AnthropicState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.AnthropicState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.AnthropicState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Proxy Ollama / endpoint personnalisé ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🦙" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Custom endpoint" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="#1F006CFF">
                                            <TextBlock Text="Aucune donnée ne quitte le poste" FontSize="11" Foreground="#0063B1" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBox Header="URL du point de terminaison (compatible OpenAI)"
                                             Text="{x:Bind ViewModel.ProxyBaseUrl, Mode=TwoWay}"
                                             PlaceholderText="http://localhost:11434/v1"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="Modèle personnalisé (tag Ollama, ex : mistral:7b)"
                                                 Text="{x:Bind ViewModel.CustomEndpointModel, Mode=TwoWay}"/>
                                        <PasswordBox Grid.Column="1" x:Name="ProxyPasswordBox" Header="Clé d'API (optionnelle)"
                                                     PasswordRevealMode="Peek" PasswordChanged="ProxyPasswordBox_PasswordChanged"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="proxy"/>
                                        <Button Grid.Column="1" Content="🔍 Charger les modèles (/models)" Command="{x:Bind ViewModel.ScanProxyModelsCommand}"/>
                                        <Button Grid.Column="2" Content="Effacer la clé" Tag="proxy" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.ProxyState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.ProxyState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.ProxyState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Vertex AI ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="☁️" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Google Cloud Vertex AI (entreprise)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="ID du projet GCP" Text="{x:Bind ViewModel.VertexProject, Mode=TwoWay}"/>
                                        <TextBox Grid.Column="1" Header="Région" Text="{x:Bind ViewModel.VertexRegion, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="vertex"/>
                                        <ProgressRing Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.VertexState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.VertexState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.VertexState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Vercel AI Gateway ══ -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="▲" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Vercel AI Gateway — un point d'accès multi-modèles" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="#107C10"/>
                                                <TextBlock Text="Coffre Windows" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" Background="#1F107C10"
                                                Visibility="{x:Bind ViewModel.IsVercelKeyConfigured, Mode=OneWay}">
                                            <TextBlock Text="● Clé configurée" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <PasswordBox x:Name="VercelPasswordBox" PlaceholderText="Clé Vercel AI Gateway…"
                                                 PasswordRevealMode="Peek" PasswordChanged="VercelPasswordBox_PasswordChanged"/>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Content="Obtenir une clé ↗" NavigateUri="https://vercel.com/ai-gateway" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Tester la connexion" Command="{x:Bind ViewModel.TestConnectionCommand}" CommandParameter="vercel"/>
                                        <Button Grid.Column="2" Content="Effacer" Tag="vercel" Click="ClearApiKey_Click"/>
                                        <ProgressRing Grid.Column="3" Width="16" Height="16" HorizontalAlignment="Left"
                                                      IsActive="{x:Bind ViewModel.VercelState.IsTesting, Mode=OneWay}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.VercelState.StatusText, Mode=OneWay}"
                                                   Foreground="{x:Bind ViewModel.VercelState.StatusBrush, Mode=OneWay}"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="⚡ Tester tous les fournisseurs"
                                    Command="{x:Bind ViewModel.TestAllConnectionsCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- ───── Matrice de routage 7 tâches ───── -->
                    <controls:SettingsExpander Header="Matrice de routage — 7 tâches"
                                               Description="Choisissez le fournisseur et le modèle utilisés pour chaque tâche de génération."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <Grid ColumnSpacing="12" Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.7*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TÂCHE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="FOURNISSEUR" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="MODÈLE (modifiable à la main)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.RoutingMatrix, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="4,4"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ModelRoutingItem">
                                        <Grid ColumnSpacing="12" Padding="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.7*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Icon}" FontSize="18" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      ItemsSource="{x:Bind ProviderOptions}"
                                                      SelectedItem="{x:Bind SelectedProvider, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:ProviderOption">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Icon}"/>
                                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                      IsEditable="True"
                                                      ItemsSource="{x:Bind AvailableModels, Mode=OneWay}"
                                                      Text="{x:Bind Model, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- ───── Températures ───── -->
                    <controls:SettingsExpander Header="Créativité des modèles (température)"
                                               Description="Contrôle fin du niveau de créativité : 0 = déterministe, 2 = très créatif.">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9CA;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📝 Génération de fiches" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GenerationTemperatureLabel, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="2" StepFrequency="0.05" TickFrequency="0.5" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.GenerationTemperature, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎯 Classification d'intention" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.IntentTemperatureLabel, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="2" StepFrequency="0.05" TickFrequency="0.5" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.IntentTemperature, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="💬 Assistant conversationnel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AssistantTemperatureLabel, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="2" StepFrequency="0.05" TickFrequency="0.5" TickPlacement="Outside"
                                        Value="{x:Bind ViewModel.AssistantTemperature, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsExpander>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 3 · DOSSIERS &amp; EMPLACEMENTS           -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelFolders" Spacing="12" Visibility="Collapsed">

                    <TextBlock Text="Emplacements de stockage" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsExpander Header="Guides pédagogiques (PDF)"
                                               Description="Sources analysées pour la table des matières et le contexte pédagogique."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8A5;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.GuidesDir, Mode=OneWay}" IsReadOnly="True"
                                         PlaceholderText="Aucun dossier sélectionné"/>
                                <Button Grid.Column="1" Content="Parcourir…" Command="{x:Bind ViewModel.BrowseGuidesDirCommand}"/>
                                <Button Grid.Column="2" Content="Ouvrir" Command="{x:Bind ViewModel.OpenGuidesFolderCommand}">
									<Button.KeyboardAccelerators>
										<KeyboardAccelerator Key="O" Modifiers="Control,Shift"/>
									</Button.KeyboardAccelerators>                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsGuidesAccessPersistent, Mode=OneWay}">
                                <Border Style="{StaticResource PillBadgeStyle}" Background="#1F107C10">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#107C10"/>
                                        <TextBlock Text="Accès persistant accordé (FutureAccessList WinRT)" FontSize="11" Foreground="#107C10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.GuidesAccessToken, Mode=OneWay}" FontSize="11"
                                           FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="Dossier des exportations (PDF, DOCX, RTF)"
                                               Description="Destination par défaut de toutes vos fiches exportées.">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B7;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.ExportsDir, Mode=OneWay}" IsReadOnly="True"
                                         PlaceholderText="Aucun dossier sélectionné"/>
                                <Button Grid.Column="1" Content="Parcourir…" Command="{x:Bind ViewModel.BrowseExportsDirCommand}"/>
                                <Button Grid.Column="2" Content="Ouvrir" Command="{x:Bind ViewModel.OpenExportsFolderCommand}"/>
                            </Grid>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <TextBlock Text="Cache &amp; maintenance" Style="{StaticResource SectionHeaderStyle}"/>

                    <controls:SettingsCard Header="Cache de la table des matières"
                                           Description="{x:Bind ViewModel.TocCacheSizeText, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F3;"/></controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsCacheBusy, Mode=OneWay}"/>
                            <Button Content="Ouvrir" Command="{x:Bind ViewModel.OpenTocCacheFolderCommand}"/>
                            <Button Content="Vider le cache" Click="ClearCache_Click"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Journaux de l'application (Serilog)"
                                           Description="Consultez les journaux locaux en cas de comportement inattendu.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsCard.HeaderIcon>
                        <Button Content="Ouvrir le dossier des journaux" Command="{x:Bind ViewModel.OpenLogsFolderCommand}"/>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 4 · STYLES &amp; PERSONNALISATION         -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelStyles" Spacing="12" Visibility="Collapsed">

                    <TextBlock Text="Galerie de préréglages" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Sélectionner un préréglage charge instantanément sa palette dans le StyleBuilder ci-dessous."
                               Style="{StaticResource CaptionNoteStyle}"/>

                    <GridView ItemsSource="{x:Bind ViewModel.StylePresets, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                              SelectionMode="Single" IsItemClickEnabled="False" MaxHeight="230">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:StylePresetItem">
                                <Border Width="176" CornerRadius="8" BorderThickness="1" Padding="0,0,0,10"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <Grid Height="64" CornerRadius="8,8,0,0" Background="{x:Bind PrimaryBrush}">
                                            <TextBlock Text="{x:Bind Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Name}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                        </Grid>
                                        <StackPanel Padding="10,8,10,0" Spacing="6">
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap" MaxHeight="34"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="12" Height="12" Fill="{x:Bind PrimaryBrush}"/>
                                                <Ellipse Width="12" Height="12" Fill="{x:Bind SecondaryBrush}"/>
                                                <Ellipse Width="12" Height="12" Fill="{x:Bind AccentBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- ───── StyleBuilder ───── -->
                    <controls:SettingsExpander Header="StyleBuilder — personnalisation avancée"
                                               Description="Couleurs, typographie et marges du document généré. L'aperçu se met à jour en direct."
                                               IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE790;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">

                            <TextBlock Text="Palette du document" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="10" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Primaire" FontWeight="SemiBold" FontSize="12"/>
                                        <ColorPicker Color="{x:Bind ViewModel.BuilderPrimaryColor, Mode=TwoWay}"
                                                     IsAlphaEnabled="False" IsHexInputVisible="True" IsColorPreviewVisible="True"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="10" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Secondaire" FontWeight="SemiBold" FontSize="12"/>
                                        <ColorPicker Color="{x:Bind ViewModel.BuilderSecondaryColor, Mode=TwoWay}"
                                                     IsAlphaEnabled="False" IsHexInputVisible="True" IsColorPreviewVisible="True"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="10" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Accentuation" FontWeight="SemiBold" FontSize="12"/>
                                        <ColorPicker Color="{x:Bind ViewModel.BuilderAccentColor, Mode=TwoWay}"
                                                     IsAlphaEnabled="False" IsHexInputVisible="True" IsColorPreviewVisible="True"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Typographie &amp; mise en page" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="12" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Header="Police du document" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.FontOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.BuilderFontFamily, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="1" Header="Arrondi des encadrés (px)" Minimum="0" Maximum="24"
                                           SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderCornerRadius, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Header="Marge haute (mm)" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginTop, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="1" Header="Marge basse (mm)" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginBottom, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="2" Header="Marge gauche (mm)" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginLeft, Mode=TwoWay}"/>
                                <NumberBox Grid.Column="3" Header="Marge droite (mm)" Minimum="5" Maximum="40" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.BuilderMarginRight, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- ───── Générateur de style par IA ───── -->
                    <controls:SettingsExpander Header="✨ Générateur de style par IA"
                                               Description="Analysez un PDF modèle : PROFstudio en déduit l'identité visuelle (palette, typographie, CSS).">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE99A;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <TextBlock Style="{StaticResource CaptionNoteStyle}"
                                       Text="Fournissez une fiche PDF dont vous appréciez la charte graphique. Le pipeline d'analyse extrait la palette dominante, la hiérarchie typographique et génère une feuille de style CSS propre, injectée dans le moteur de rendu."/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="📄 Analyser un PDF de référence…" Click="AnalyzeStylePdf_Click"
                                        Style="{ThemeResource DefaultButtonStyle}"/>
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsAnalyzingStyle, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind ViewModel.StyleAnalysisStatus, Mode=OneWay}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <TextBox Text="{x:Bind ViewModel.GeneratedCss, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Cascadia Code, Consolas" FontSize="12" AcceptsReturn="True"
                                     TextWrapping="NoWrap" MinHeight="150"
                                     Visibility="{x:Bind ViewModel.HasGeneratedCss, Mode=OneWay}"
                                     Header="Feuille de style générée"/>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- ───── Aperçu en direct ───── -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Aperçu en direct" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <ToggleSwitch Grid.Column="1" x:Name="DarkPreviewToggle" Toggled="DarkPreviewToggle_Toggled"
                                      OnContent="Sombre" OffContent="Clair" MinWidth="0"
                                      ToolTipService.ToolTip="Prévisualiser la fiche en mode sombre"/>
                        <Button Grid.Column="2" Content="🔄 Actualiser" Click="RefreshPreview_Click" Margin="8,0,0,0"/>
                    </Grid>

                    <Border CornerRadius="8" BorderThickness="1" Padding="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <WebView2 x:Name="StylePreviewWebView" Height="440"/>
                    </Border>
                    <StackPanel x:Name="WebViewFallback" Visibility="Collapsed" Spacing="6" Padding="20"
                                HorizontalAlignment="Stretch">
                        <TextBlock Text="⚠ Le runtime WebView2 est requis pour l'aperçu en direct." FontWeight="SemiBold"/>
                        <HyperlinkButton Content="Télécharger WebView2 Runtime ↗"
                                         NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/"/>
                    </StackPanel>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 5 · CONFIDENTIALITÉ &amp; RGPD            -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelPrivacy" Spacing="12" Visibility="Collapsed">

                    <!-- Carte de flux RGPD -->
                    <Border Padding="18" CornerRadius="10" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE83D;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Conformité RGPD — le parcours de vos données" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Transparence totale sur ce qui transite, où, et comment c'est protégé."
                                               Style="{StaticResource CaptionNoteStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="💬" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Votre saisie" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Reste sur ce poste" FontSize="11" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="→" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="HTTPS chiffré" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TLS 1.3 uniquement" FontSize="11" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="→" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="☁️" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Fournisseur IA" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Celui que vous avez routé" FontSize="11" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="→" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Width="132" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Fiche générée" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Stockée localement" FontSize="11" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="• Aucune donnée n'est vendue, partagée ou utilisée pour entraîner des modèles tiers par PROFstudio." Style="{StaticResource CaptionNoteStyle}"/>
                                <TextBlock Text="• Vos clés d'API ne quittent jamais le Coffre d'identification Windows (chiffrement DPAPI)." Style="{StaticResource CaptionNoteStyle}"/>
                                <TextBlock Text="• Recommandation : ne saisissez jamais de données nominatives d'élèves dans les prompts." Style="{StaticResource CaptionNoteStyle}"/>
                                <TextBlock Text="• Option 100 % hors-ligne disponible via le fournisseur « Proxy local / Ollama »." Style="{StaticResource CaptionNoteStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <controls:SettingsCard Header="Télémétrie anonyme"
                                           Description="Désactivée par défaut. Si activée : statistiques d'usage agrégées uniquement, sans contenu pédagogique ni identifiant.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F5;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.TelemetryEnabled, Mode=TwoWay}" OnContent="Autorisée" OffContent="Refusée"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Génération multi-passe (expérimental)"
                                           Description="Deux passes de rédaction + relecture automatique pour une qualité contextuelle accrue. Consomme environ 2× plus de jetons.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;"/></controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.ExpMultiPassGen, Mode=TwoWay}" OnContent="Activé" OffContent="Désactivé"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Niveau de journalisation (diagnostic)"
                                           Description="Verbosité des journaux Serilog locaux. « Information » recommandé au quotidien.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></controls:SettingsCard.HeaderIcon>
                        <ComboBox MinWidth="200" SelectedItem="{x:Bind ViewModel.DiagnosticLogLevel, Mode=TwoWay}"
                                  ItemsSource="{x:Bind ViewModel.LogLevels, Mode=OneWay}"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Rétention de l'historique des fiches"
                                           Description="Durée de conservation en jours. 0 = conservation illimitée.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;"/></controls:SettingsCard.HeaderIcon>
                        <NumberBox Minimum="0" Maximum="365" SpinButtonPlacementMode="Inline" MinWidth="140"
                                   Value="{x:Bind ViewModel.HistoryRetentionDays, Mode=TwoWay}"/>
                    </controls:SettingsCard>

                    <controls:SettingsExpander Header="Diagnostic &amp; maintenance"
                                               Description="Exportez un pack de diagnostic complet pour le support technique.">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D7;"/></controls:SettingsExpander.HeaderIcon>
                        <StackPanel Style="{StaticResource ExpanderInnerPanelStyle}">
                            <TextBlock Style="{StaticResource CaptionNoteStyle}"
                                       Text="Le pack (.zip) contient les journaux Serilog, la configuration et l'état du routage IA. Les clés d'API et tous les secrets sont systématiquement expurgés avant l'archivage."/>
                            <Button Content="📦 Exporter le pack de diagnostic (.zip)"
                                    Command="{x:Bind ViewModel.ExportDiagnosticBundleCommand}"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </controls:SettingsExpander>

                    <!-- Zone de danger -->
                    <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="#C42B1C" Background="#0FC42B1C">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚠ Zone de danger" FontWeight="SemiBold" Foreground="#C42B1C"/>
                            <TextBlock Text="Rétablit tous les paramètres d'usine (thème, routage IA, styles, promptes). Vos clés d'API du coffre Windows et vos dossiers sont conservés."
                                       Style="{StaticResource CaptionNoteStyle}"/>
                            <Button Content="Réinitialiser tous les paramètres" Click="ResetAll_Click" HorizontalAlignment="Left"
                                    Foreground="#C42B1C"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══════════════════════════════════════════════ -->
                <!-- ONGLET 6 · PROMPTS &amp; RACCOURCIS              -->
                <!-- ══════════════════════════════════════════════ -->
                <StackPanel x:Name="PanelPrompts" Spacing="12" Visibility="Collapsed">

                    <TextBlock Text="Modèles de prompts personnalisables" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Adaptez les instructions envoyées aux modèles IA. Variables disponibles : {Niveau}, {Matiere}, {Sujet}, {Consigne}."
                               Style="{StaticResource CaptionNoteStyle}"/>

                    <Grid ColumnSpacing="14" MinHeight="320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListView Grid.Column="0"
                                  ItemsSource="{x:Bind ViewModel.PromptTemplates, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPromptTemplate, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PromptTemplateItem">
                                    <StackPanel Padding="6,4" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Column="1" Padding="14" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedPromptTemplate.Name, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="↺ Réinitialiser ce modèle"
                                            Command="{x:Bind ViewModel.ResetPromptTemplateCommand}"/>
                                </Grid>
                                <TextBox Text="{x:Bind ViewModel.SelectedPromptTemplate.Content, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220"
                                         FontFamily="Cascadia Code, Consolas" FontSize="12"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Les modifications sont enregistrées avec le bouton « Enregistrer les paramètres » (Ctrl+S)."
                                           Style="{StaticResource CaptionNoteStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Raccourcis clavier" Style="{StaticResource SectionHeaderStyle}"/>
                    <controls:SettingsCard Header="Éditeur de raccourcis"
                                           Description="Personnalisez les combinaisons de touches. Appliqués au prochain démarrage de PROFstudio.">
                        <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;"/></controls:SettingsCard.HeaderIcon>
                        <Button Content="↺ Tout rétablir" Command="{x:Bind ViewModel.ResetShortcutsCommand}"/>
                    </controls:SettingsCard>
                    <ListView ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:KeyboardShortcutItem">
                                <Grid ColumnSpacing="12" Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Action}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBox Grid.Column="1" Text="{x:Bind Keys, Mode=TwoWay}" FontFamily="Consolas"
                                             PlaceholderText="ex : Ctrl+Entrée"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- BARRE D'ACTION INFÉRIEURE                                -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{x:Bind ViewModel.LastSavedText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"/>
                    <Button Style="{ThemeResource AccentButtonStyle}" Padding="24,10"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            ToolTipService.ToolTip="Enregistrer (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Enregistrer les paramètres"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>